// Original recreation inspired by the publicly described feature set of "TraderLion's Enhanced Volume"
// (source code for that script is closed/proprietary; this is an independent implementation from scratch).
//@version=6
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// INDICATOR
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
indicator(title = 'Enhanced Volume', shorttitle = 'EVol+', overlay = false, format = format.volume)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// INPUTS
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
ev_ma_len = input.int(
     defval = 50,
     minval = 1,
     title  = 'Volume MA Length',
     group  = 'Volume Coloring'
 )

ev_high_rvol = input.float(
     defval  = 1.4,
     minval  = 1.0,
     step    = 0.1,
     title   = 'High Rel. Volume Threshold (x MA)',
     group   = 'Volume Coloring',
     tooltip = 'Volume at or above this multiple of its moving average is colored as high volume'
 )

ev_low_rvol = input.float(
     defval  = 0.6,
     minval  = 0.0,
     maxval  = 1.0,
     step    = 0.1,
     title   = 'Low Rel. Volume Threshold (x MA)',
     group   = 'Volume Coloring',
     tooltip = 'Volume at or below this multiple of its moving average is colored as low volume'
 )

ev_high_color = input.color(color.lime, 'High Volume Color', group = 'Volume Coloring')
ev_low_color  = input.color(color.orange, 'Low Volume Color', group = 'Volume Coloring')

ev_up_day_color = input.color(
     color.new(color.green, 85),
     'Up Day Volume Color',
     group   = 'Volume Coloring',
     tooltip = 'Used on green (close >= open) days when volume is not extreme. Kept mostly transparent so it reads as a hollow/border-only bar'
 )

ev_down_day_color = input.color(
     #8B0000,
     'Down Day Volume Color',
     group   = 'Volume Coloring',
     tooltip = 'Used on red (close < open) days when volume is not extreme. Dark red rather than a bright red'
 )

ev_ma_color = input.color(color.new(color.blue, 0), 'Volume MA Color', group = 'Volume Coloring')

ev_show_labels = input.bool(
     defval = true,
     title  = 'Show High-Volume Labels',
     group  = 'Volume Labels'
 )

ev_label_min_rvol = input.float(
     defval  = 1.4,
     minval  = 1.0,
     step    = 0.1,
     title   = 'Min Rel. Volume to Trigger Label',
     group   = 'Volume Labels',
     tooltip = 'Show a shares-traded + %-above-average label when relative volume reaches this multiple'
 )

ev_label_color = input.color(color.new(color.lime, 0), 'Label Text Color', group = 'Volume Labels')

ev_show_hv = input.bool(
     defval = true,
     title  = 'Show HV1 / HVE / HVIPO Markers',
     group  = 'Historical Volume Markers'
 )

ev_hve_lookback = input.int(
     defval  = 2520,
     minval  = 50,
     title   = 'HVE Lookback (bars, ~10y daily)',
     group   = 'Historical Volume Markers',
     tooltip = 'Highest volume in this many bars back (default approximates 10 years on a daily chart)'
 )

ev_hv1_lookback = input.int(
     defval  = 252,
     minval  = 20,
     title   = 'HV1 Lookback (bars, ~1y daily)',
     group   = 'Historical Volume Markers',
     tooltip = 'Highest volume in this many bars back (default approximates 1 year on a daily chart)'
 )

ev_dv_len = input.int(
     defval = 50,
     minval = 1,
     title  = 'Avg Dollar Volume Length',
     group  = 'Dollar Volume & U/D Ratio'
 )

ev_ud_len = input.int(
     defval  = 50,
     minval  = 1,
     title   = 'Up/Down Volume Ratio Length',
     group   = 'Dollar Volume & U/D Ratio',
     tooltip = 'Sum of up-day volume divided by sum of down-day volume over this many bars'
 )

ev_show_table = input.bool(
     defval = true,
     title  = 'Show Stats Table',
     group  = 'Dollar Volume & U/D Ratio'
 )

ev_show_runrate = input.bool(
     defval  = true,
     title   = 'Show Intraday Relative Volume Run-Rate',
     group   = 'Intraday Run-Rate',
     tooltip = 'Projects full-session volume from volume-so-far vs. session time elapsed. Only active on intraday charts'
 )

ev_session_minutes = input.int(
     defval  = 390,
     minval  = 1,
     title   = 'Regular Session Length (minutes)',
     group   = 'Intraday Run-Rate',
     tooltip = 'Default 390 = US equities regular session (9:30-16:00)'
 )

ev_runrate_days = input.int(
     defval = 20,
     minval = 5,
     title  = 'Run-Rate Avg Daily Volume Lookback (days)',
     group  = 'Intraday Run-Rate'
 )

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// FUNCTIONS
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
f_format_vol(v) =>
    string txt = v >= 1000000000 ? str.tostring(v / 1000000000, '#.##') + 'B' :
                 v >= 1000000    ? str.tostring(v / 1000000, '#.##') + 'M' :
                 v >= 1000       ? str.tostring(v / 1000, '#.##') + 'K' :
                 str.tostring(v, '#')
    txt

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// VOLUME COLORING
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
float vol_ma  = ta.sma(volume, ev_ma_len)
float rel_vol = vol_ma != 0 ? volume / vol_ma : na
float pct_vs_avg = vol_ma != 0 ? (volume - vol_ma) / vol_ma * 100 : na

bool is_green_day = close >= open
color day_color = is_green_day ? ev_up_day_color : ev_down_day_color

color bar_color = na(rel_vol) ? day_color :
     rel_vol >= ev_high_rvol ? ev_high_color :
     rel_vol <= ev_low_rvol  ? ev_low_color  :
     day_color

plot(volume, title = 'Volume', style = plot.style_columns, color = bar_color)
plot(vol_ma, title = 'Volume MA', color = ev_ma_color, linewidth = 2)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// HIGH-VOLUME LABELS
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
if ev_show_labels and not na(rel_vol) and rel_vol >= ev_label_min_rvol
    string vol_txt = f_format_vol(volume)
    string pct_txt = '+' + str.tostring(pct_vs_avg, '#.#') + '%'
    label.new(
         x          = bar_index,
         y          = volume,
         text       = vol_txt + '\n' + pct_txt,
         style      = label.style_label_down,
         color      = color.new(color.black, 100),
         textcolor  = ev_label_color,
         size       = size.small
     )

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// HISTORICAL VOLUME MARKERS (HVIPO / HVE / HV1)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
int lookback_hve = math.min(ev_hve_lookback, bar_index + 1)
int lookback_hv1 = math.min(ev_hv1_lookback, bar_index + 1)

float highest_hve = ta.highest(volume, lookback_hve)
float highest_hv1 = ta.highest(volume, lookback_hv1)

var float all_time_max_vol = na
bool is_hvipo = na(all_time_max_vol) or volume > all_time_max_vol
all_time_max_vol := is_hvipo ? volume : all_time_max_vol

bool is_hve = volume >= highest_hve
bool is_hv1 = volume >= highest_hv1

string hv_tag = is_hvipo ? 'HVIPO' : is_hve ? 'HVE' : is_hv1 ? 'HV1' : na

plotshape(
     ev_show_hv and hv_tag == 'HVIPO',
     title    = 'HVIPO Marker',
     location = location.top,
     style    = shape.labelup,
     text     = 'HVIPO',
     color    = color.new(color.purple, 0),
     textcolor = color.white,
     size     = size.tiny
 )

plotshape(
     ev_show_hv and hv_tag == 'HVE',
     title    = 'HVE Marker',
     location = location.top,
     style    = shape.labelup,
     text     = 'HVE',
     color    = color.new(color.red, 0),
     textcolor = color.white,
     size     = size.tiny
 )

plotshape(
     ev_show_hv and hv_tag == 'HV1',
     title    = 'HV1 Marker',
     location = location.top,
     style    = shape.labelup,
     text     = 'HV1',
     color    = color.new(color.orange, 0),
     textcolor = color.white,
     size     = size.tiny
 )

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// DOLLAR VOLUME & UP/DOWN VOLUME RATIO
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
float dollar_vol     = close * volume
float avg_dollar_vol = ta.sma(dollar_vol, ev_dv_len)

float up_vol = close > close[1] ? volume : 0.0
float dn_vol = close < close[1] ? volume : 0.0
float sum_up_vol = ta.sma(up_vol, ev_ud_len) * ev_ud_len
float sum_dn_vol = ta.sma(dn_vol, ev_ud_len) * ev_ud_len
float ud_ratio = sum_dn_vol != 0 ? sum_up_vol / sum_dn_vol : na

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// INTRADAY RELATIVE VOLUME RUN-RATE
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
bool is_intraday = timeframe.isintraday
bool new_session = ta.change(time('D')) != 0

var float cum_vol_today    = 0.0
var float session_start_ts = na

if new_session
    cum_vol_today    := volume
    session_start_ts := time
else
    cum_vol_today := cum_vol_today + volume

float minutes_elapsed  = is_intraday ? (time - session_start_ts) / 1000 / 60 + timeframe.in_seconds() / 60.0 : na
float fraction_elapsed = is_intraday ? math.min(minutes_elapsed / ev_session_minutes, 1.0) : na

avg_daily_vol = request.security(syminfo.tickerid, 'D', ta.sma(volume, ev_runrate_days)[1], lookahead = barmerge.lookahead_off)

float projected_vol = is_intraday and fraction_elapsed > 0 ? cum_vol_today / fraction_elapsed : na
float run_rate_pct  = is_intraday and avg_daily_vol != 0 and not na(projected_vol) ? projected_vol / avg_daily_vol * 100 : na

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// STATS TABLE
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
var table stats_table = table.new(position.top_right, 2, 4, border_width = 1)

if barstate.islast and ev_show_table
    table.cell(stats_table, 0, 0, 'Rel. Volume', text_color = color.white, bgcolor = color.new(color.black, 30))
    table.cell(stats_table, 1, 0, na(rel_vol) ? 'n/a' : str.tostring(rel_vol, '#.##') + 'x', text_color = color.white, bgcolor = color.new(color.black, 30))

    table.cell(stats_table, 0, 1, 'Avg $ Volume', text_color = color.white, bgcolor = color.new(color.black, 30))
    table.cell(stats_table, 1, 1, f_format_vol(avg_dollar_vol), text_color = color.white, bgcolor = color.new(color.black, 30))

    table.cell(stats_table, 0, 2, 'U/D Ratio', text_color = color.white, bgcolor = color.new(color.black, 30))
    table.cell(stats_table, 1, 2, na(ud_ratio) ? 'n/a' : str.tostring(ud_ratio, '#.##'), text_color = color.white, bgcolor = color.new(color.black, 30))

    table.cell(stats_table, 0, 3, 'Run-Rate', text_color = color.white, bgcolor = color.new(color.black, 30))
    table.cell(stats_table, 1, 3, (is_intraday and ev_show_runrate and not na(run_rate_pct)) ? str.tostring(run_rate_pct, '#.#') + '%' : 'n/a', text_color = color.white, bgcolor = color.new(color.black, 30))

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// END
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
