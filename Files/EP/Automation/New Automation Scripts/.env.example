# Copy this file to ".env" in this same folder and fill in real values.
# ".env" is gitignored -- never commit it. This is the "clean" credential
# pattern requested for the long-side engine (the old short-side scripts
# hardcode these in source; this one does not).

# --- DAS Trader Pro CMD API login (this account's LONG book) ---
# Confirm this is a DIFFERENT account number than the short-side system if
# you intended a separate risk allocation. If DAS only exposes one CMD API
# port per running terminal instance, and you run a second terminal instance
# for this account, change DAS_PORT to match that instance's configured port.
DAS_HOST=127.0.0.1
DAS_PORT=9910
DAS_USER=CHANGE_ME
DAS_PASS=CHANGE_ME
DAS_ACCT=CHANGE_ME

# --- Risk sizing (see README "Risk sizing" section before going live) ---
# Dollars subtracted from current equity before computing per-trade risk.
DAS_ACCOUNT_RESERVE=0
# Fraction of (equity - reserve) risked per trade, e.g. 0.05 = 5%.
RISK_PCT_PER_TRADE=0.05

# --- Discord notifications (optional; leave blank to disable) ---
# Can be the SAME webhook the short-side system uses, or a different one if
# you want long-side alerts in a separate channel.
DISCORD_WEBHOOK_URL=

# --- Google Sheets ---
# Service-account credentials file, path relative to this script's folder.
SHEET_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=EP Long Entry Sheet
