//@version=6
// HTF Pattern Labels (TEST) -- GENERATED by generate_pattern_overlay.py; edit that, not this.
// Auto-labels from htf_pattern_labeler.py, 2 tickers AA..AMD; a check mark = you reviewed it.
// Per flag: dotted line = local max, top/bottom fitted lines (green = rising, red = falling),
// label on the box top = slot + pattern (+ share of the pole given back, optional) (HTF vs Flag cut is 40%).
// Boxes, confirm line, slot number and R1 are drawn exactly like the Flag Recorder's.
indicator("HTF Pattern Labels (TEST)", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

boxPad   = input.float(1.0, "Box padding %", minval = 0.0, maxval = 10.0)
showFits = input.bool(true, "Show fitted top/bottom lines")
showMax  = input.bool(true, "Show local max line")
showPole = input.bool(false, "Show % of pole given back", tooltip = "How much of the run-up the pullback gave back. Under 40% = HTF, 40%+ = Flag. Turn on to see why a flag landed in HTF vs Flag.")

D0 = ";AA:CF,200605,13.86,200713,200612,11.95,200708,12.02,200615,11.07,200710,10.6,41,1✓,200611,200715,200707,12.97,10.27,1,200623,12.31/PH,200717,13.86,200731,200722,13.37,200729,13.34,200724,12.3,200730,12.47,21,2✓,200720,200803,200731,13.78,12.3,1,200722,13.38/CF,200903,14.78,201016,201006,12.53,201014,13.2,201006,11.92,201015,11.61,84,3✓,200925,201021,201019,13.6,10.98,1,201014,13.14/CF,200903,14.78,201104,201006,12.61,201103,14.34,201006,11.75,201029,12.04,84,4✓,200925,201106,201030,14.54,10.98,1,201023,14.14/PH,201204,24.17,201230,201217,23.12,201228,22.84,201216,21.26,201229,21.12,23,5✓,201214,201231,201228,23.43,21.13,0,201217,23.21/CF,210107,26.2,210218,210128,19.54,210217,23.07,210129,17.77,210212,20.96,60,6✓,210127,210222,210219,25.48,17.3,1,210216,22.62/DF,210510,44.42,210730,210512,40.02,210726,37.58,210511,38.13,210719,32.75,57,8✓,210525,210802,210629,41.65,31,0,210601,41.16/TH,210928,52.45,211014,211004,50.54,211012,48.75,211001,47,211013,46.3,36,9✓,210920,211015,211013,56.93,44.48,1,210928,52.45/DF,211018,57.57,211215,211025,50.01,211214,51.07,211022,46.46,211213,44.83,68,10✓,211027,211216,211124,54.15,43.26,1,211112,52.86/DF,220103,62.61,220203,220105,62.64,220126,64.33,220104,58.33,220131,54.77,48,11✓,220104,220208,220202,71.97,53.26,0,220126,63.64/SP,260114,66.95,260331,260204,63.46,260326,65.61,260205,56.91,260326,58.43,37,12✓,260202,260401,260311,72.17,55.04,0,260304,68.4/DF,260409,75.7,260521,260416,69.86,260513,65.29,260417,63.4,260519,61.31,72,13✓,260417,260522,260520,72.85,60.91,0,260513,69.73"
D1 = ";AMD:PH,90409,3.92,90501,90414,3.709,90424,3.686,90415,3.271,90428,3.288,38,1✓,90402,90504,90422,4.3,3.04,1,90409,3.92/CF,90601,4.9,90826,90709,3.814,90825,3.97,90713,3.57,90819,3.586,60,2✓,90622,90828,90804,4.55,3.22,1,90721,4.25/DH,90922,6.3,91009,90929,6.1,91006,5.78,90925,5.383,91008,5.301,41,3✓,90924,91012,91005,6.29,5.05,0,90929,6.1/PH,130515,4.42,130625,130521,4.138,130619,4.128,130523,3.843,130620,3.858,29,4✓,130520,130711,130617,4.45,3.79,1,130521,4.2/TH,150205,3.37,150227,150210,3.129,150225,3.146,150211,2.993,150226,3.044,36,5✓,150209,150302,150224,3.23,2.93,1,150213,3.18/DH,160330,2.98,160421,160401,2.875,160418,2.805,160401,2.727,160419,2.589,28,6✓,160324,160422,160408,3.99,2.6,0,160330,2.98/PH,160422,3.99,160513,160428,3.803,160511,3.689,160429,3.466,160512,3.529,31,7✓,160425,160517,160512,3.98,3.31,1,160505,3.8/PH,160531,4.71,160615,160607,4.67,160614,4.51,160602,4.165,160615,4.383,25,8✓,160602,160616,160610,4.75,4.07,1,160607,4.67/PH,160622,5.52,160715,160629,5.309,160714,5.165,160627,4.753,160708,4.895,30,9✓,160624,160719,160711,5.57,4.65,1,160629,5.4/TH,160726,7.16,160817,160808,6.85,160815,6.97,160802,6.142,160810,6.248,27,10✓,160729,160819,160815,8,6.15,1,160728,6.98/CF,160822,7.95,161024,160923,6.825,161020,7.11,160923,6.325,161021,6.503,59,11✓,160913,161025,161010,7.5,5.66,1,161003,7.15/CF,160819,8,161115,160923,6.846,161108,7.434,160923,6.391,161110,6.545,60,12✓,160912,161117,161114,8.77,5.66,1,161025,7.5/DF,161228,12.42,170131,161230,11.79,170127,10.56,161229,11.28,170120,9.577,48,13✓,161230,170201,170117,12.14,9.42,0,170109,11.64/CF,170228,15.55,170330,170308,14.03,170324,14.45,170315,13.58,170327,13.28,44,14✓,170303,170331,170324,14.75,12.38,1,170320,14.5/PF,170428,13.76,170606,170516,12.33,170531,11.08,170505,10.15,170602,10.81,130,15✓,170504,170609,170606,13.4,9.94,1,170516,12.77/PH,180618,17.34,180705,180627,15.76,180629,15.49,180625,14.56,180702,14.78,34,16✓,180621,180706,180629,16.87,14.54,0,180625,15.74/TH,180618,17.34,180725,180627,15.81,180724,17.2,180628,14.86,180723,16.34,31,17✓,180626,180726,180719,18.45,14.74,1,180619,17.29/TH,180730,20.18,180813,180801,18.93,180813,19.93,180802,18,180810,18.85,23,18✓,180801,180822,180814,20.92,18,1,180730,20.18/PH,180827,27.3,180831,180828,26.01,180831,25.24,180828,23.96,180831,24.8,25,19✓,180828,180904,180830,28.11,24.01,1,180827,27.3/PH,180913,34.14,180924,180913,33.63,180924,32.1,180913,30.54,180924,31,22,20✓,180913,180925,180921,34.14,29.87,1,180918,33.37/CF,181017,28.53,190402,190102,20.43,190321,26.36,190103,18.31,190327,24.79,98,21✓,181030,181203,181126,23.75,16.17,1,180910,29.93/CF,181004,28.83,190130,181009,25.66,190125,19.22,181008,22,190129,17.26,98,22✓,181025,190131,190108,25.14,16.03,0,181203,23.75/CF,200303,50.2,200609,200325,51.93,200604,57.06,200403,49.18,200605,52.37,99,23✓,200323,200610,200528,59,38.95,1,200420,58.63/CF,200303,50.2,200721,200325,52.97,200715,57.26,200403,49.84,200714,52.64,99,24✓,200323,200722,200706,62,38.95,1,200610,59/DF,200902,94.28,200930,200910,82.79,200922,78.48,200904,76.29,200924,73.71,44,25✓,200904,200930,200924,84.39,73.85,0,200910,83.31/CF,200902,94.28,201127,200910,82.09,201123,86.46,200904,75.23,201124,80.54,45,26✓,200904,201130,201030,92.74,73.76,0,201008,88.72/DF,210804,122.5,210826,210811,110.7,210825,110.1,210810,104.4,210819,102,41,27✓,210809,210830,210823,114.5,102,0,210813,111.7/DF,210804,122.5,211015,210811,112.2,211007,106.2,210810,106.5,211011,101,46,28✓,210810,211018,210922,116.9,99.51,0,210830,114.5/DF,211130,164.5,211215,211130,158.3,211215,137.6,211206,134.2,211214,130.6,52,29✓,211130,211223,211214,164.5,130.6,0,211208,147/SP,260603,546.4,260629,260609,521.1,260625,565.5,260609,449.5,260624,515.8,31,30✓,260605,260630,260626,584.7,437.2,1,260622,563/DF,260630,584.7,260730,260706,571,260722,562.6,260702,520.3,260729,429.7,42,31✓,260707,260917,260730,574.2,424,0,260814,514.7"

cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
seg = s0 + s1

var string[] recs = array.new<string>()
var bool parsed = false
while not parsed
    parsed := true
    parts = str.split(seg, "/")
    j = 0
    while j < array.size(parts)
        array.push(recs, array.get(parts, j))
        j += 1

// YYMMDD -> bar time (daily bars stamp at the session open; xloc.bar_time tolerates the offset)
t(string s) =>
    v = int(str.tonumber(s))
    y = 2000 + int(math.floor(v / 10000))
    m = int(math.floor(v / 100)) % 100
    timestamp(syminfo.timezone, y, m, v % 100, 9, 30)

name(string c) =>
    c == "TH" ? "Green" : c == "PH" ? "Perfect" : c == "DH" ? "Red" : c == "EH" ? "Expanding" : c == "SP" ? "Spiky Top" : c == "CF" ? "Big Green" : c == "PF" ? "Big Perfect" : c == "NP" ? "Null" : "Big Red"

lineCol(float p0, float p1) => p1 > p0 ? color.green : color.red

if barstate.islast
    i = 0
    while i < array.size(recs)
        f = str.split(array.get(recs, i), ",")
        if array.size(f) >= 22
            // --- the recorder's own drawing ---
            t0 = t(array.get(f, 14))
            t1 = t(array.get(f, 15))
            tc = t(array.get(f, 16))
            hi = str.tonumber(array.get(f, 17))
            lo = str.tonumber(array.get(f, 18))
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(f, 19) == "1" ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 100), border_width = 1, bgcolor = color.new(col, 90))
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed)
            // slot number + auto-label share the recorder's label on the box's top edge
            txt = array.get(f, 13) + " " + name(array.get(f, 0)) + (showPole ? "\n" + array.get(f, 12) + "% of pole" : "")
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = txt, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            if array.get(f, 20) != "0"
                r1 = str.tonumber(array.get(f, 21))
                line.new(x1 = t(array.get(f, 20)), y1 = r1, x2 = extEnd, y2 = r1, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
            // --- the auto-label ---
            if showMax
                maxP = str.tonumber(array.get(f, 2))
                line.new(t(array.get(f, 1)), maxP, t(array.get(f, 3)), maxP, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
            if showFits and array.get(f, 4) != "0"
                p0 = str.tonumber(array.get(f, 5))
                p1 = str.tonumber(array.get(f, 7))
                line.new(t(array.get(f, 4)), p0, t(array.get(f, 6)), p1, xloc = xloc.bar_time, color = lineCol(p0, p1), width = 2)
            if showFits and array.get(f, 8) != "0"
                q0 = str.tonumber(array.get(f, 9))
                q1 = str.tonumber(array.get(f, 11))
                line.new(t(array.get(f, 8)), q0, t(array.get(f, 10)), q1, xloc = xloc.bar_time, color = lineCol(q0, q1), width = 2)
        i += 1
