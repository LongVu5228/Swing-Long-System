D8 = ";VRTX:050513-050527,051006-051031,060309-060314,080404-080428,080930-081009,110927-110930,200414-200415|050513-050527,051006-051031,060309-060314,080404-080502,090121-090128,110927-110930,200414-200415|050513-050527,051006-051031,060309-060314,080428-080502,080930-081009,090114-090128,110927-110930,200414-200415;VRUS:110316-110324,110608-110802,110912-111021|110316-110324,110608-110802,110912-111021|110316-110324,110608-110802,110912-111021;VRX:081201-081202,100520-100521|081125-081230,100520-100521|080922-081007,081125-090107,100520-100521;VSAT:230321-230324,240726-240812,250325-250402,250707-250905,260717-260817|230321-230324,240808-240812,250804-251104,260717-260813|230321-230324,250707-251112,260107-260202,260717-260821;VSCN:070724-070727,071026-071107|070724-070731|071026-071106;VSEA:070803-070913|070803-070913|070803-070913;VSEC:250305-250318|250310-250407|250312-250407;VSH:090630-090702,260520-260623|090624-090701,260519-260629|090626-090701,260518-260629;VSI:120517-120522|120517-120522|120517-120522;VSLR:150311-150407,200221-200305,200713-201009|150311-150407,200224-200228,200715-201009|150406-150407,190809-190830,200720-201009;VST:240409-240610,241007-250204|240409-240610,241007-250204|240409-240610,241007-250204;VSTM:180615-180910,250808-250905,260715-260904|180613-180914,210526-210629|180615-180914;VSTO:|220118-220119|220118-220119;VSTTF:241104-241118|241104-241105|;VSXY:211203-211208,220118-220119,221021-221103,231101-231212,240829-240905,251208-251218,260608-260701|220118-220203,221021-221026,231101-240105,241212-241220,251202-260220|220119-220120,231101-240105,240906-240909,241212-241226,251211-260227;VTGN:230814-230918|230814-230920|230814-230920;VTIV:080124-080125||;VTNRQ:210527-210623,220224-220610,221026-221104,230228-230403,230922-230925|210527-210716,220301-220617,230307-230404,230922-230925|210527-210716,220324-220617,230228-230405,230922-230925;VTR:081230-090102,200526-200617||201118-201120;VTRS:090303-090310|090120-090316|090120-090316,2