:080820-080902,090811-091006,220216-220223,250307-250312|080828-080902,090901-091006,250423-250429|080822-080902,090901-091006|500,080820,250429,5,BKE;BKE:080129-080207,090227-090330,171201-171204,181116-181119|090223-090421,171201-171215|080129-080211,090212-090323|501,080129,181119,4,BKI;BKI:||110119-110128|502,110119,110128,1,BKKT;BKKT:220228-220301,241119-241211,250923-251020|241119-241120|251001-251008|503,220228,251020,3,BKNG;BKNG:070816-070817,071109-071203,080220-080403,081203-081208,090311-090313|070816-070817,071109-071203,080220-080404,081230-090102,090311-090313|070816-070817,071109-071203,080220-080404,090311-090313,090521-090522|504,070816,090522,7,BKR;BKR:220311-220323|220311-220323|220311-220323|505,220311,220323,1,BKSY"
D8 = ";BKS:090318-090324,091127-091209,100819-100908,110504-110624,111111-111207,120217-120228,121009-121113,130516-130521,181008-181024,190610-190618|090318-090407,091201-091202,100819-100908,110512-110624,111117-111207,121009-121113,130516-130613,131209-131210,181008-181024,190610-190618|090126-090319,100819-100908,110512-110624,111114-111207,120224-120228,121009-121113,130516-130613,181012-181024,190610-190618|507,090126,190618,11,BKV;BKSY:220603-220616,250204-250219,250707-250718,260325-260417|220705-220706,250124-250220,250701-250717,260402-260406|250708-250717,260512-260522|506,220603,260522,6,BKS;BKV:251114-251117|||508,251114,251117,1,BLCM;BLCM:170707-170710|||509,170707,170710,1,BLCO;BLCO:220923-220927|||510,220923,220927,1,BLDP;BLD:220518-220520|||513,220518,220520,1,BLFS;BLDP:060424-060509,140303-140325,140613-140808,170918-171016,200115-200226,200623-200716,210112-210209,211029-211102|060424-060510,140303-140325,140613-140808,170918-171116,200115-200302,210125-210218,260505-260604|060424-060510,140303-140325,140613-140808,170918-171116,200115-200302,200423-200424,200611-200717,210125-210216|511,060424,260604,10,BLDR;BLDR:150427-150501,150901-150908,240805-240808|150427-150501,150824-150908,220309-220310,240805-240808|150427-150501,150824-150908,220309-220325,220519-220613,240805-240808|512,150427,240808,5,BLD;BLFS:|210827-210913|210830-210915|514,210827,210915,1,BLIAQ;BLIAQ:070830-070927|070830-070927|070905-070927|515,070830,070927,1,BLIN;BLIN:210706-210716|210706-210716|210706-210716|516,210706,210716,1,BLK;BLK:080402-080410,080801-080805,090327-090403|080402-080410,080801-080805,090409-090505|080402-080410,080801-080805,081230-090114,090327-090506|517,080402,090506,4,BLKB;BLKB:070815-070820,260729-260814|||518,070815,260814,2,BLLN;BLLN:|260724-260805|260728-260804|519,260724,260805,1,BLND;BLND:220207-220224,240821-240903||240821-240830|520,220207,240903,2,BLNK;BLNK:180514-180606,200630-200814,201006-201007,201119-201222,211115-211119|180516-180607,200706-200820,201119-210212|200706-200819,201006-210128|521,180514,211119,4,BLOX;BLOX:130306-130313,131011-131104|130306-130313,131011-131104|130306-130313,131011-131104|522,130306,131104,2,BLPH;BLPH:200325-200424,230313-230417|200325-200501,230313-230417|200325-200421,230313-230417|523,200325,230417,2,BLRX;BLRX:201109-201112,210504-210507|||524,201109,210507,2,BLSH;BLSH:260826-260921|||525,260826,260921,1,BLTE;BLTE:251121-251215|251121-260204|251201-260223|526,251121,260223,1,BLUE;BLU:210914-211008,211227-220105|210914-211025,211223-220104|210923-211001,211223-220106,220714-220825|528,210914,220825,3,BLZE"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "|||" : seg   // absent ticker still yields four empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// TICKER LIST PANEL (replaced the 1M/3M/6M color legend, 2026-11-10)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Where this ticker sits on the HTF ticker list, so you don't have to flip to the sheet:
// first / last seen on the scanner, number of streaks, and the next ticker to chart.
// Field 4 of the segment: "row,firstYYMMDD,lastYYMMDD,n_streaks,next", "~" between list rows
// that share this chart symbol.
panelSize = input.string("normal", "Panel text size", options = ["small", "normal", "large"])
fmt(string yymmdd) =>
    v = int(str.tonumber(yymmdd))
    str.tostring(int(v / 100) % 100) + "/" + str.tostring(v % 100) + "/" + str.tostring(2000 + int(v / 10000))

var table panel = table.new(position.bottom_left, 2, 6, bgcolor = color.new(color.white, 100), border_width = 0)
if barstate.islast
    ts = panelSize == "small" ? size.small : panelSize == "large" ? size.large : size.normal
    info = array.get(str.split(segp, "|"), 3)
    rows = str.split(info, "~")
    r = 0
    if info == ""
        table.cell(panel, 0, 0, syminfo.ticker + " is not on the HTF ticker list", text_color = color.gray, text_size = ts)
    else
        k = 0
        while k < array.size(rows)
            f = str.split(array.get(rows, k), ",")
            // 2x2: first | last seen, then streaks (+ list row) | next ticker
            table.cell(panel, 0, r, "First seen  " + fmt(array.get(f, 1)), text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 1, r, "Last seen  " + fmt(array.get(f, 2)), text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 0, r + 1, "Streaks  " + array.get(f, 3) + "   (row " + array.get(f, 0) + ")", text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 1, r + 1, "Next  " + array.get(f, 4), text_color = color.orange, text_size = ts, text_halign = text.align_left)
            r += 2
            k += 1
