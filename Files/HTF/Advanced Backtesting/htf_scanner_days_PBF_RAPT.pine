|051125-051208,170731-170803,181112-181113,200311-200807,201012-201109,210726-210727,211203-211231|051125-051208,170731-170803,181112-181115,200311-200814,201012-201109,210726-210809,211201-211231;QEP:151007-151028,160324-160513,171107-171120,200608-200616,201211-201217|151007-151118,160330-160513,171107-171120,200609-200610|151007-151028,160317-160513,171107-171120;QFIN:200713-200731,210211-210301,210601-210630,220621-220630,221128-221223,250324-250403|200720-200721,210316-210330,210601-210701,220624-220701,221206-221223,230206-230210,250220-250403|200720-200722,210601-210702,230206-230210,250221-250404;QIHU:110722-110907,120309-120410,120820-120913,121205-121212,131022-131023,140124-140321|110722-110729,120309-120410,120820-120913,121205-121212,131022-131023,140129-140321|120203-120410,120820-120913,121205-121212,131022-131023,140124-140321;QIWI:131008-140102,140527-140617,150421-150601|131008-140102,140527-140617|131031-140102,140527-140617,150421-150603"
D8 = ";QLIK:111020-111114|111020-111121|111020-111121;QLYS:200409-200413,260715-260724|200409-200413,260715-260821|200409-200413;QMAR:071019-071107|071025-071108|071018-071108;QMCO:241202-250107,260616-260622,260812-260910|241202-250113,260604-260624,260812-260921|241218-250108,260812-260921;QMMM:250801-251008|241108-241114,250801-251009|250801-251009;QNCX:191224-200109,210804-210908|191224-200204,210708-210910|191224-191226,210716-210910;QNST:181101-190111|181101-190111|180309-180314,181101-190208;QRVO:060426-060428,080514-080522,090427-090428,090612-090724|090427-090817|090610-090817;QS:210701-210706,210924-211129,230125-230228,230630-230802,231201-240122,240717-240731,250626-250801,250919-251110|210302-210329,210701-210706,210927-211129,230215-230303,230728-230802,240110-240122,240717-240724,250626-250801,250919-251113|210701-210706,210927-211119,230630-230801,240111-240122,240717-240722,250626-250801,251001-251113;QSI:241210-250121|241227-250121|;QSR:141212-141215|141212-141215|141212-141215;QTEX:260601-260615|260601-260702|;QTRX:210119-210122||;QTTB:260527-260727|260527-260825|260527-260825;QTTOY:190116-190327,190724-190729|190116-190327,190724-190729|190319-190327,190724-190729;QUAD:180302-180313||;QUBT:241113-250108,250403-250407,250516-250710|241113-250110,250516-250721|241113-250110,250403-250407,250515-250721;QUCY:260518-260608|260518-260605|;QUIK:|260515-260603|260515-260616;QUNR:150407-150410,150526-150529,151021-160106|150407-150410,150526-150529,151026-160106|150407-150410,150526-150529,151021-160106;QURE:171020-171110,180503-180504,181130-181217,190213-190329,190523-190708,191209-191227,220718-220722,221125-221206,240711-240801,241213-241231,250926-251023,260622-260713|150410-150422,171020-171110,180503-180711,190213-190329,190523-190708,191209-191227,220627-220801,221123-221205,240711-240801,241213-250204,250926-251103,260618-260805|150410-150422,150921-150924,171020-171110,180503-180717,181130-181212,190213-190329,190523-190708,191209-191227,220711-220801,221125-221206,241211-250106,250507-250612,250926-251031;QXO:231226-240117,250328-250404,250625-250702|231226-240117,250521-250702|231226-240117,250331-250410,250625-250702;RADI:220520-220526,221206-221214|220520-220525|;RAIL:080208-080221,210401-210430|210405-210513|210429-210514;RAMP:201103-201105|201103-201105|201103-201105;RANI:251020-251114|251020-251118|;RAPP:250908-250919||250908-250909,260723-260729;RAPT:210623-210708,220105-220107|210729-210730,220107-220113,230223-230313,251030-251212|210729-210730,230131-230309,251020-251230"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "||" : seg   // absent ticker still yields three empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// LEGEND
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legend text colors are deliberately NOT the actual (heavily transparent) on-chart swatch
// colors -- at high layerTransparency those are too washed out to read as text. Single-window
// entries use the pure input color; overlap entries blend the two pure colors at a fixed,
// legend-only mix so they stay bright regardless of layerTransparency.
blend(base, fg, transp) =>
    a = (100 - transp) / 100.0
    r = math.round(color.r(base) * (1 - a) + color.r(fg) * a)
    g = math.round(color.g(base) * (1 - a) + color.g(fg) * a)
    b = math.round(color.b(base) * (1 - a) + color.b(fg) * a)
    color.rgb(r, g, b)

legendMix = 50
lc1m3m = blend(color1m, color3m, legendMix)
lc1m6m = blend(color1m, color6m, legendMix)
lc3m6m = blend(color3m, color6m, legendMix)
lcAll  = blend(lc1m3m, color6m, legendMix)

var table legend = table.new(
     position.bottom_left,
     4,
     3,
     bgcolor = color.new(color.white, 100),
     border_width = 0
 )

if barstate.islast
    table.cell(legend, 0, 0, "1M only", text_color = color1m, text_size = size.normal)
    table.cell(legend, 1, 0, "3M only", text_color = color3m, text_size = size.normal)
    table.cell(legend, 2, 0, "6M only", text_color = color6m, text_size = size.normal)
    table.cell(legend, 3, 0, "1M+3M+6M", text_color = lcAll, text_size = size.normal)
    table.cell(legend, 0, 1, "1M+3M", text_color = lc1m3m, text_size = size.normal)
    table.cell(legend, 1, 1, "1M+6M", text_color = lc1m6m, text_size = size.normal)
    table.cell(legend, 2, 1, "3M+6M", text_color = lc3m6m, text_size = size.normal)
    table.cell(legend, 0, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 1, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 2, 2, " ", text_color = color.new(color.white, 100))
    table.merge_cells(legend, 3, 0, 3, 1)
