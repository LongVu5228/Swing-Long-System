,100122-100204,100408-100506,101014-101119,200817-200918,210305-210308|090827-091021,100122-100204,100408-100506,101014-101119,200817-200918,210305-210323;MGNI:190827-190909,200110-200225,201027-210218,221111-221213,230215-230222,230524-230608,240604-240605|190827-190909,201104-210301,221125-221220,230203-230210,250902-250905|190827-190909,201130-210301,230216-230228,250902-250909;MGNX:141222-150105,150715-150716,151028-151117,190207-190304,190530-190605,200506-200602,210322-210326,240201-240216|141222-150114,150715-150716,190207-190222,190530-190605,200506-200721,210427-210430,240201-240306|141222-150114,150320-150325,150715-150716,151028-151123,190207-190222,190530-190605,200506-200513,200910-200928,210427-210430,240201-240318;MGPI:060426-060524,190502-190503|060426-060524,190502-190503|060426-060524,190502-190503;MGTI:160523-160720|160523-160720|160523-160720;MGTX:211104-211109||;MGY:220124-220209|210304-210308,220131-220215|220121-220215;MHGC:080730-080828|080815-080904|"
D8 = ";MHK:081226-090102,090406-090427,220511-220518||;MHO:240802-240806||240808-240809;MHS:||081126-081215;MI:080909-081008,090818-091007,091217-100203,100421-100505,210322-210412,220405-220418|080918-081008,090513-090518,090828-091007,091217-100203,100421-100506,210322-210504|090828-090831,091217-100203,100421-100506,210322-210504,210901-210915;MIDD:070809-070828,200604-200605|090427-090429|;MIK:190913-191018,200618-200701|190925-191104,200629-200706,200819-200914|190930-191104,200826-200915;MIPS:101007-110119|101007-110125|101007-110125;MIRM:191219-200113,240620-240812|191219-200113,240621-240820|240627-240820;MIST:200728-200820||;MITK:||260720-260721;MITT:200609-200612||;MKL:||090120-090122;MKSI:260204-260225,260626-260708|260204-260303|260205-260303,260507-260508,260623-260710;MKTO:131106-131107,131226-140115,160511-160527|131226-140110,160510-160527|131226-140115,160512-160527;MKTX:200413-200422|200413-200422|200413-200422;ML:241108-241119|240510-240612|240314-240613;MLAB:221118-221201||;MLCO:080215-080220,090803-090925,100224-100422,110202-110209,110516-110518,151027-151111,220121-220124,220923-221018,221128-230106|090504-090528,090831-090923,100224-100422,110202-110209,110516-110518,160229-160302,220201-220222,220928-221018,221128-230208|080219-080325,090504-090528,090803-090923,100224-100422,110202-110209,110516-110518,151026-151111,220927-221019,221130-230208;MLGO:230922-231206,240701-240705,250227-250416|230922-231206,240701-240708,250305-250416|230922-231206,240701-240703,250324-250416;MLKN:111012-111020,200923-200925|111012-111014|111012-111021;MLM:||080813-080911,081231-090113;MLNM:080118-080129|080118-080129|080118-080129;MLNX:110928-110930,120427-120508,120620-120725,130319-130426|110922-110930,120427-120508,120620-120725,130319-130426|110922-110930,120427-120508,120620-120725,130319-130426;MLTX:230525-230830,231011-231019,231213-231222,240709-240716,251128-251204|230523-230830,231011-231019,240709-240815,250507-250508|230523-230830,231011-231019,231213-231221,240709-240716;MLYS:250310-250403,250903-251001|250310-250331,250515-250516,250908-251201|250310-250403,250905-250916,251030-251201;MM:121005-121109,130516-130614|121005-121109,130516-130614|080205-080208,121005-121109,130516-130614"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "||" : seg   // absent ticker still yields three empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// LEGEND
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legend text colors are deliberately NOT the actual (heavily transparent) on-chart swatch
// colors -- at high layerTransparency those are too washed out to read as text. Single-window
// entries use the pure input color; overlap entries blend the two pure colors at a fixed,
// legend-only mix so they stay bright regardless of layerTransparency.
blend(base, fg, transp) =>
    a = (100 - transp) / 100.0
    r = math.round(color.r(base) * (1 - a) + color.r(fg) * a)
    g = math.round(color.g(base) * (1 - a) + color.g(fg) * a)
    b = math.round(color.b(base) * (1 - a) + color.b(fg) * a)
    color.rgb(r, g, b)

legendMix = 50
lc1m3m = blend(color1m, color3m, legendMix)
lc1m6m = blend(color1m, color6m, legendMix)
lc3m6m = blend(color3m, color6m, legendMix)
lcAll  = blend(lc1m3m, color6m, legendMix)

var table legend = table.new(
     position.bottom_left,
     4,
     3,
     bgcolor = color.new(color.white, 100),
     border_width = 0
 )

if barstate.islast
    table.cell(legend, 0, 0, "1M only", text_color = color1m, text_size = size.normal)
    table.cell(legend, 1, 0, "3M only", text_color = color3m, text_size = size.normal)
    table.cell(legend, 2, 0, "6M only", text_color = color6m, text_size = size.normal)
    table.cell(legend, 3, 0, "1M+3M+6M", text_color = lcAll, text_size = size.normal)
    table.cell(legend, 0, 1, "1M+3M", text_color = lc1m3m, text_size = size.normal)
    table.cell(legend, 1, 1, "1M+6M", text_color = lc1m6m, text_size = size.normal)
    table.cell(legend, 2, 1, "3M+6M", text_color = lc3m6m, text_size = size.normal)
    table.cell(legend, 0, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 1, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 2, 2, " ", text_color = color.new(color.white, 100))
    table.merge_cells(legend, 3, 0, 3, 1)
