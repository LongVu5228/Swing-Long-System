D21 = ";BW:DH,171017,44.4,171030,171020,43.7,171026,42.33,171025,39.2,171026,39.2,18,1✓,171019,171031,171027,44,39.2,0,171020,43.7/DH,171101,44.8,171109,171101,43.17,171109,42.14,171101,41.95,171109,37.13,27,2✓,171019,171110,171103,46.8,36.7,0,171101,44.8/DH,171124,50.6,171211,171130,48.82,171204,48.3,171128,44.69,171206,43.54,24,3✓,171124,171212,171206,50.6,43.4,1,171204,48.3/PF,210401,9.9,210526,210430,9.194,210521,8.248,210504,8.064,210525,7.44,50,4✓,210416,210601,210524,9.36,6.53,1,210505,8.96/DF,210430,9.36,210809,210505,9.171,210802,7.351,210504,8.237,210804,6.538,82,5✓,210513,210813,210803,9.42,6.42,0,210721,7.44/DF,210607,9.42,211101,210609,8.358,211026,6.538,210610,7.468,211027,6.032,119,6✓,210622,211102,211014,8.26,5.81,0,211004,7.19/DF,251112,7.77,251231,251118,7.107,251224,5.495,251114,5.858,251222,4.872,50,7✓,251119,260102,251218,7.55,4.57,0,251212,6.49/DF,260204,11.57,260303,260209,10.48,260302,9.285,260205,8.696,260226,8.548,52,8✓,260211,260304,260227,12.03,7.95,0,260218,10.02/TH,260320,16.24,260402,260326,15.8,260330,16,260324,13.49,260330,12.96,28,9✓,260320,260406,260331,17.59,12.96,0,260330,16/DF,260415,18.8,260508,260417,18.09,260507,15.35,260422,14.54,260504,13.62,47,10✓,260420,260511,260504,18.99,13.58,0,260427,16.04;BWA:DF,260212,70.08,260320,260226,58.36,260319,51.92,260223,56.17,260319,49.24,68,1✓,260224,260323,260316,60.08,50.21,0,260310,54.02/CF,260217,64.28,260416,260317,53.72,260414,55.56,260319,51.32,260415,52.97,59,2✓,260310,260430,260415,57.67,50.49,1,260325,56.65/CF,260212,70.08,260407,260310,53.11,260401,55.54,260313,50.51,260402,52.38,68,3✓,260304,260417,260402,56.71,50.21,1,260408,55.8/DF,260603,78.82,260804,260608,76.12,260731,62.85,260605,71.17,260729,59.56,66,4✓,260625,260805,260727,69.85,60.07,0,260722,65.32"

cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
s9 = cut(D9, key)
s10 = cut(D10, key)
s11 = cut(D11, key)
s12 = cut(D12, key)
s13 = cut(D13, key)
s14 = cut(D14, key)
s15 = cut(D15, key)
s16 = cut(D16, key)
s17 = cut(D17, key)
s18 = cut(D18, key)
s19 = cut(D19, key)
s20 = cut(D20, key)
s21 = cut(D21, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13 + s14 + s15 + s16 + s17 + s18 + s19 + s20 + s21

var string[] recs = array.new<string>()
var bool parsed = false
while not parsed
    parsed := true
    parts = str.split(seg, "/")
    j = 0
    while j < array.size(parts)
        array.push(recs, array.get(parts, j))
        j += 1

// YYMMDD -> bar time (daily bars stamp at the session open; xloc.bar_time tolerates the offset)
t(string s) =>
    v = int(str.tonumber(s))
    y = 2000 + int(math.floor(v / 10000))
    m = int(math.floor(v / 100)) % 100
    timestamp(syminfo.timezone, y, m, v % 100, 9, 30)

name(string c) =>
    c == "TH" ? "Green" : c == "PH" ? "Perfect" : c == "DH" ? "Red" : c == "EH" ? "Expanding" : c == "SP" ? "Spiky Top" : c == "CF" ? "Big Green" : c == "PF" ? "Big Perfect" : c == "NP" ? "Null" : "Big Red"

lineCol(float p0, float p1) => p1 > p0 ? color.green : color.red

if barstate.islast
    i = 0
    while i < array.size(recs)
        f = str.split(array.get(recs, i), ",")
        if array.size(f) >= 22
            // --- the recorder's own drawing ---
            t0 = t(array.get(f, 14))
            t1 = t(array.get(f, 15))
            tc = t(array.get(f, 16))
            hi = str.tonumber(array.get(f, 17))
            lo = str.tonumber(array.get(f, 18))
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(f, 19) == "1" ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 100), border_width = 1, bgcolor = color.new(col, 90))
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed)
            // slot number + auto-label share the recorder's label on the box's top edge
            txt = array.get(f, 13) + " " + name(array.get(f, 0)) + (showPole ? "\n" + array.get(f, 12) + "% of pole" : "")
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = txt, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            if array.get(f, 20) != "0"
                r1 = str.tonumber(array.get(f, 21))
                line.new(x1 = t(array.get(f, 20)), y1 = r1, x2 = extEnd, y2 = r1, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
            // --- the auto-label ---
            if showMax
                maxP = str.tonumber(array.get(f, 2))
                line.new(t(array.get(f, 1)), maxP, t(array.get(f, 3)), maxP, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
            if showFits and array.get(f, 4) != "0"
                p0 = str.tonumber(array.get(f, 5))
                p1 = str.tonumber(array.get(f, 7))
                line.new(t(array.get(f, 4)), p0, t(array.get(f, 6)), p1, xloc = xloc.bar_time, color = lineCol(p0, p1), width = 2)
            if showFits and array.get(f, 8) != "0"
                q0 = str.tonumber(array.get(f, 9))
                q1 = str.tonumber(array.get(f, 11))
                line.new(t(array.get(f, 8)), q0, t(array.get(f, 10)), q1, xloc = xloc.bar_time, color = lineCol(q0, q1), width = 2)
        i += 1
