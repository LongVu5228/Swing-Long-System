D21 = ";CLOV:CF,240822,3.815,240912,240903,2.79,240912,2.711,240906,2.455,240910,2.47,47,1✓,240827,240916,240906,3.4,2.455,1,240904,2.985/CF,240822,3.815,241001,240904,3.023,240925,3.116,240906,2.429,240923,2.824,47,2✓,240829,241002,240925,3.65,2.455,0,240918,3.2/TH,241004,4.285,241016,241009,4.03,241011,4.22,241010,3.79,241014,3.93,23,3✓,241008,241016,241011,4.275,3.62,1,241004,4.285/DF,241106,4.5,250106,241113,3.505,241231,3.352,241115,3.254,241231,3.096,59,4✓,241108,250107,241218,3.755,2.95,0,241205,3.54/PH,250124,4.87,250219,250205,4.665,250213,4.599,250207,4.272,250218,4.384,43,5✓,250130,250220,250213,4.8,4.05,1,250206,4.66/DF,260629,5.59,260805,260714,4.901,260803,4.424,260708,4.511,260731,4.097,37,6✓,260702,260806,260729,5.51,4.12,0,260721,4.878;CLS:DF,80519,9.86,80613,80521,9.892,80611,8.83,80520,9.438,80612,8.309,42,1✓,80527,80616,80610,9.69,8.27,0,80604,9.18/DF,250207,140,250512,250213,116.5,250508,81.21,250210,107.3,250509,72.71,132,2✓,250228,250513,250423,110.8,58.05,0,250324,101.5/TH,250527,124.7,250609,250529,117.1,250609,123.9,250530,110.5,250606,118.2,21,3✓,250529,250610,250606,126.2,110.5,1,250527,124.7/TH,250923,261.8,251009,250929,251.4,251002,257.6,250925,230.3,251007,233.1,22,5✓,250915,251013,251009,270.1,227,1,250923,261.8/DF,251105,363.4,251209,251110,336.6,251128,336.5,251107,302.3,251203,290.9,53,6✓,251106,251120,251118,361.8,275.8,0,251110,346.2/CF,251128,344.8,260126,251224,311.1,260120,324.8,251229,289.9,260122,287.2,59,7✓,251209,260127,260120,353.4,266,1,260113,333.8/DF,260127,337.1,260324,260128,331.4,260318,272.8,260202,276.3,260319,258.1,125,8✓,260127,260325,260310,352.2,244.5,0,260224,307.1/DF,260505,435,260528,260514,375.9,260526,372.1,260512,354.5,260521,332,58,9✓,260506,260529,260522,429.3,324.5,0,260514,382.6"

cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
s9 = cut(D9, key)
s10 = cut(D10, key)
s11 = cut(D11, key)
s12 = cut(D12, key)
s13 = cut(D13, key)
s14 = cut(D14, key)
s15 = cut(D15, key)
s16 = cut(D16, key)
s17 = cut(D17, key)
s18 = cut(D18, key)
s19 = cut(D19, key)
s20 = cut(D20, key)
s21 = cut(D21, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13 + s14 + s15 + s16 + s17 + s18 + s19 + s20 + s21

var string[] recs = array.new<string>()
var bool parsed = false
while not parsed
    parsed := true
    parts = str.split(seg, "/")
    j = 0
    while j < array.size(parts)
        array.push(recs, array.get(parts, j))
        j += 1

// YYMMDD -> bar time (daily bars stamp at the session open; xloc.bar_time tolerates the offset)
t(string s) =>
    v = int(str.tonumber(s))
    y = 2000 + int(math.floor(v / 10000))
    m = int(math.floor(v / 100)) % 100
    timestamp(syminfo.timezone, y, m, v % 100, 9, 30)

name(string c) =>
    c == "TH" ? "Green" : c == "PH" ? "Perfect" : c == "DH" ? "Red" : c == "EH" ? "Expanding" : c == "SP" ? "Spiky Top" : c == "CF" ? "Big Green" : c == "PF" ? "Big Perfect" : c == "NP" ? "Null" : "Big Red"

lineCol(float p0, float p1) => p1 > p0 ? color.green : color.red

if barstate.islast
    i = 0
    while i < array.size(recs)
        f = str.split(array.get(recs, i), ",")
        if array.size(f) >= 22
            // --- the recorder's own drawing ---
            t0 = t(array.get(f, 14))
            t1 = t(array.get(f, 15))
            tc = t(array.get(f, 16))
            hi = str.tonumber(array.get(f, 17))
            lo = str.tonumber(array.get(f, 18))
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(f, 19) == "1" ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 100), border_width = 1, bgcolor = color.new(col, 90))
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed)
            // slot number + auto-label share the recorder's label on the box's top edge
            txt = array.get(f, 13) + " " + name(array.get(f, 0)) + (showPole ? "\n" + array.get(f, 12) + "% of pole" : "")
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = txt, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            if array.get(f, 20) != "0"
                r1 = str.tonumber(array.get(f, 21))
                line.new(x1 = t(array.get(f, 20)), y1 = r1, x2 = extEnd, y2 = r1, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
            // --- the auto-label ---
            if showMax
                maxP = str.tonumber(array.get(f, 2))
                line.new(t(array.get(f, 1)), maxP, t(array.get(f, 3)), maxP, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
            if showFits and array.get(f, 4) != "0"
                p0 = str.tonumber(array.get(f, 5))
                p1 = str.tonumber(array.get(f, 7))
                line.new(t(array.get(f, 4)), p0, t(array.get(f, 6)), p1, xloc = xloc.bar_time, color = lineCol(p0, p1), width = 2)
            if showFits and array.get(f, 8) != "0"
                q0 = str.tonumber(array.get(f, 9))
                q1 = str.tonumber(array.get(f, 11))
                line.new(t(array.get(f, 8)), q0, t(array.get(f, 10)), q1, xloc = xloc.bar_time, color = lineCol(q0, q1), width = 2)
        i += 1
