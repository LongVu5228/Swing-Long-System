D4 = ";CVBF:TH,100224,9.59,100304,100225,9.434,100304,9.511,100225,9.194,100304,9.304,23,1✓,100225,100305,100302,9.76,9.12,1,100224,9.59;CVE:TH,200518,4.47,200526,200519,4.34,200526,4.383,200519,3.997,200526,4.271,16,1✓,200519,200601,200526,4.52,3.985,1,200518,4.47/DF,200608,5.83,200720,200619,4.785,200715,4.693,200618,4.428,200714,4.169,38,2✓,200616,200721,200710,5.09,4.135,0,200706,4.89;CVI:CF,110217,17.16,110324,110228,15.9,110322,16.51,110302,13.73,110323,15.71,40,1✓,110223,110325,110316,17.69,13.81,1,110304,17.06/DF,110406,19.29,110527,110415,18.9,110519,15.96,110412,16.91,110523,14.6,64,2✓,110407,110614,110524,19,14.48,0,110510,17.41/PF,110801,22.44,110825,110815,21.06,110819,20.4,110816,19.19,110823,17.94,91,3✓,110808,110826,110823,21.59,15.2,1,110815,21.15/DF,110908,23.43,111010,110913,22.04,110927,20.06,110914,19.95,111004,14.65,108,4✓,110912,111011,111004,22.17,14.56,0,110927,19.94/DF,170103,20.51,170424,170110,19.61,170418,15.31,170109,18.02,170419,14.24,60,5✓,170125,170425,170413,20.32,13.87,0,170329,16.15/TH,220505,33.88,220525,220511,31.87,220518,33.17,220512,29.34,220524,31.17,32,6✓,220510,220526,220520,34,28.46,1,220505,33.88/DF,220607,43.61,220725,220614,40.62,220718,30.7,220613,35.3,220721,25.88,69,7✓,220621,220728,220714,37.79,27.56,0,220708,32.37/CF,220802,35.69,220824,220810,32.82,220823,34.66,220805,30.07,220822,30.48,78,8✓,220803,220825,220816,36.77,29.34,1,220802,35.69/DF,220825,36.77,221006,220826,37.63,220928,29.89,220901,32.46,220926,26.12,123,9✓,220825,221007,220926,37.63,25.48,0,220912,34.66/DH,221027,42.21,221111,221102,39.35,221111,39.5,221102,37.26,221111,37.81,38,10✓,221102,221114,221110,41.26,35.94,0,221107,40.93/DH,260331,35.72,260424,260407,33.4,260422,32.08,260401,30.36,260423,29.77,43,11✓,260401,260427,260421,33.57,28.79,0,260416,33.22/TH,260505,35.33,260601,260512,35.6,260526,33.09,260507,32.12,260527,31.35,30,12✓,260505,260602,260526,35.95,30.59,0,260518,35.15"

cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
seg = s0 + s1 + s2 + s3 + s4

var string[] recs = array.new<string>()
var bool parsed = false
while not parsed
    parsed := true
    parts = str.split(seg, "/")
    j = 0
    while j < array.size(parts)
        array.push(recs, array.get(parts, j))
        j += 1

// YYMMDD -> bar time (daily bars stamp at the session open; xloc.bar_time tolerates the offset)
t(string s) =>
    v = int(str.tonumber(s))
    y = 2000 + int(math.floor(v / 10000))
    m = int(math.floor(v / 100)) % 100
    timestamp(syminfo.timezone, y, m, v % 100, 9, 30)

name(string c) =>
    c == "TH" ? "Green" : c == "PH" ? "Perfect" : c == "DH" ? "Red" : c == "EH" ? "Expanding" : c == "SP" ? "Spiky Top" : c == "CF" ? "Big Green" : c == "PF" ? "Big Perfect" : c == "NP" ? "Null" : "Big Red"

lineCol(float p0, float p1) => p1 > p0 ? color.green : color.red

if barstate.islast
    i = 0
    while i < array.size(recs)
        f = str.split(array.get(recs, i), ",")
        if array.size(f) >= 22
            // --- the recorder's own drawing ---
            t0 = t(array.get(f, 14))
            t1 = t(array.get(f, 15))
            tc = t(array.get(f, 16))
            hi = str.tonumber(array.get(f, 17))
            lo = str.tonumber(array.get(f, 18))
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(f, 19) == "1" ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 100), border_width = 1, bgcolor = color.new(col, 90))
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed)
            // slot number + auto-label share the recorder's label on the box's top edge
            txt = array.get(f, 13) + " " + name(array.get(f, 0)) + (showPole ? "\n" + array.get(f, 12) + "% of pole" : "")
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = txt, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            if array.get(f, 20) != "0"
                r1 = str.tonumber(array.get(f, 21))
                line.new(x1 = t(array.get(f, 20)), y1 = r1, x2 = extEnd, y2 = r1, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
            // --- the auto-label ---
            if showMax
                maxP = str.tonumber(array.get(f, 2))
                line.new(t(array.get(f, 1)), maxP, t(array.get(f, 3)), maxP, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
            if showFits and array.get(f, 4) != "0"
                p0 = str.tonumber(array.get(f, 5))
                p1 = str.tonumber(array.get(f, 7))
                line.new(t(array.get(f, 4)), p0, t(array.get(f, 6)), p1, xloc = xloc.bar_time, color = lineCol(p0, p1), width = 2)
            if showFits and array.get(f, 8) != "0"
                q0 = str.tonumber(array.get(f, 9))
                q1 = str.tonumber(array.get(f, 11))
                line.new(t(array.get(f, 8)), q0, t(array.get(f, 10)), q1, xloc = xloc.bar_time, color = lineCol(q0, q1), width = 2)
        i += 1
