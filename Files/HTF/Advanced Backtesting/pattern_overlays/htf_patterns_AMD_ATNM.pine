D21 = ";ATEX:PH,260612,88.12,260625,260618,80.64,260624,82.91,260615,75.73,260625,75.4,32,3✓,260615,260629,260625,99.2,70.78,1,260612,88.12/DH,260702,111.9,260717,260709,109,260715,108.1,260707,98.62,260713,98,27,4✓,260702,260720,260717,113,91,0,260709,109;ATHM:DF,140826,57.93,141002,140903,51.35,140930,42.69,140828,45.83,140929,40.15,71,1✓,140902,141016,140930,51.88,38.54,0,141003,44.22/PF,150305,47.47,150406,150317,42.84,150330,46.06,150327,42.77,150331,42.7,59,2✓,150313,150407,150331,49,39.65,1,150323,46.24/DF,150427,56.59,150616,150504,54.91,150612,46.26,150429,49.92,150609,44.52,57,3✓,150508,150618,150610,52.8,44.02,0,150526,49.51/PH,190227,96.15,190328,190313,93.5,190326,93.77,190322,88.41,190327,90.56,38,4✓,190311,190329,190321,106,85.06,1,190319,95.5;ATI:DF,60511,87.5,60628,60516,71.39,60627,64.05,60516,62.78,60626,58.51,79,1✓,60518,60629,60609,73.6,54.78,0,60602,67.74/PF,60516,77.97,60915,60609,68.28,60913,60.83,60613,61.82,60911,56.46,81,2✓,60606,61009,60824,71.29,54.78,1,60804,65.75/TH,61025,83.15,61117,61106,79.14,61115,80.57,61102,74.57,61113,75.74,32,3✓,61101,61127,61115,84.98,74.28,1,61025,83.15/TH,61211,98.72,70119,61220,90.92,70118,92.25,61219,84.97,70109,85.61,35,4✓,61214,70123,70111,94.62,84.33,1,61228,93.14/DH,90508,40.22,90529,90515,35.35,90526,37.11,90515,32.64,90528,32.35,36,5✓,90513,90602,90529,40.67,31.78,0,90520,38.54/DH,160318,18.38,160414,160328,16.43,160330,17.04,160324,15.2,160412,14.53,36,6✓,160323,160415,160411,17.32,14.25,0,160330,17.04/PH,160727,18.67,160812,160803,17.85,160811,17.64,160803,16.54,160811,16.82,28,7✓,160802,160815,160811,18.07,16.54,1,160803,17.92;ATLX:PF,230502,45,230803,230516,23.78,230801,22.35,230522,20.54,230727,20.17,71,1✓,230509,230804,230608,29.7,17.57,1,230602,26;ATNM:PF,221103,15.12,221111,221104,12.72,221111,12.05,221104,10.67,221111,11.41,47,1✓,221104,221114,221110,13,10.52,1,221108,12.83/DF,221103,15.12,230120,221125,11.41,230118,10.7,221130,10.33,230119,9.75,60,2✓,221118,230123,221228,12.59,9.31,0,221213,11.47"

cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
s9 = cut(D9, key)
s10 = cut(D10, key)
s11 = cut(D11, key)
s12 = cut(D12, key)
s13 = cut(D13, key)
s14 = cut(D14, key)
s15 = cut(D15, key)
s16 = cut(D16, key)
s17 = cut(D17, key)
s18 = cut(D18, key)
s19 = cut(D19, key)
s20 = cut(D20, key)
s21 = cut(D21, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13 + s14 + s15 + s16 + s17 + s18 + s19 + s20 + s21

var string[] recs = array.new<string>()
var bool parsed = false
while not parsed
    parsed := true
    parts = str.split(seg, "/")
    j = 0
    while j < array.size(parts)
        array.push(recs, array.get(parts, j))
        j += 1

// YYMMDD -> bar time (daily bars stamp at the session open; xloc.bar_time tolerates the offset)
t(string s) =>
    v = int(str.tonumber(s))
    y = 2000 + int(math.floor(v / 10000))
    m = int(math.floor(v / 100)) % 100
    timestamp(syminfo.timezone, y, m, v % 100, 9, 30)

name(string c) =>
    c == "TH" ? "Green" : c == "PH" ? "Perfect" : c == "DH" ? "Red" : c == "EH" ? "Expanding" : c == "SP" ? "Spiky Top" : c == "CF" ? "Big Green" : c == "PF" ? "Big Perfect" : c == "NP" ? "Null" : "Big Red"

lineCol(float p0, float p1) => p1 > p0 ? color.green : color.red

if barstate.islast
    i = 0
    while i < array.size(recs)
        f = str.split(array.get(recs, i), ",")
        if array.size(f) >= 22
            // --- the recorder's own drawing ---
            t0 = t(array.get(f, 14))
            t1 = t(array.get(f, 15))
            tc = t(array.get(f, 16))
            hi = str.tonumber(array.get(f, 17))
            lo = str.tonumber(array.get(f, 18))
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(f, 19) == "1" ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 100), border_width = 1, bgcolor = color.new(col, 90))
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed)
            // slot number + auto-label share the recorder's label on the box's top edge
            txt = array.get(f, 13) + " " + name(array.get(f, 0)) + (showPole ? "\n" + array.get(f, 12) + "% of pole" : "")
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = txt, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            if array.get(f, 20) != "0"
                r1 = str.tonumber(array.get(f, 21))
                line.new(x1 = t(array.get(f, 20)), y1 = r1, x2 = extEnd, y2 = r1, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
            // --- the auto-label ---
            if showMax
                maxP = str.tonumber(array.get(f, 2))
                line.new(t(array.get(f, 1)), maxP, t(array.get(f, 3)), maxP, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
            if showFits and array.get(f, 4) != "0"
                p0 = str.tonumber(array.get(f, 5))
                p1 = str.tonumber(array.get(f, 7))
                line.new(t(array.get(f, 4)), p0, t(array.get(f, 6)), p1, xloc = xloc.bar_time, color = lineCol(p0, p1), width = 2)
            if showFits and array.get(f, 8) != "0"
                q0 = str.tonumber(array.get(f, 9))
                q1 = str.tonumber(array.get(f, 11))
                line.new(t(array.get(f, 8)), q0, t(array.get(f, 10)), q1, xloc = xloc.bar_time, color = lineCol(q0, q1), width = 2)
        i += 1
