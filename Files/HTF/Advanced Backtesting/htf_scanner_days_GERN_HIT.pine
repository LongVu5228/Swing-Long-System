,250204-250304,250507-250624,250731-250812|1601,220727,260706,12,HIMX;HIMX:130320-130603,130726-131015,140110-140325,141219-141224,170227-170307,170615-170620,170907-170920,171115-171208,210210-210225,211217-220113,250127-250131,260501-260605|130320-130604,130726-131017,140110-140325,150210-150212,170907-170922,171120-171208,210301-210302,210413-210421,211221-220113,250123-250305,260507-260610|130320-130604,130726-131004,140110-140325,141219-150212,160412-160415,170615-170620,170907-170921,171115-171208,210301-210302,210413-210505,210615-210719,211221-220113,260508-260609|1602,130320,260610,16,HIT;HIT:250305-250311|||1603,250305,250311,1,HITK"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "|||" : seg   // absent ticker still yields four empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// TICKER LIST PANEL (replaced the 1M/3M/6M color legend, 2026-11-10)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Where this ticker sits on the HTF ticker list, so you don't have to flip to the sheet:
// first / last seen on the scanner, number of streaks, and the next ticker to chart.
// Field 4 of the segment: "row,firstYYMMDD,lastYYMMDD,n_streaks,next", "~" between list rows
// that share this chart symbol.
panelSize = input.string("normal", "Panel text size", options = ["small", "normal", "large"])
fmt(string yymmdd) =>
    v = int(str.tonumber(yymmdd))
    str.tostring(int(v / 100) % 100) + "/" + str.tostring(v % 100) + "/" + str.tostring(2000 + int(v / 10000))

var table panel = table.new(position.bottom_left, 2, 6, bgcolor = color.new(color.white, 100), border_width = 0)
if barstate.islast
    ts = panelSize == "small" ? size.small : panelSize == "large" ? size.large : size.normal
    info = array.get(str.split(segp, "|"), 3)
    rows = str.split(info, "~")
    r = 0
    if info == ""
        table.cell(panel, 0, 0, syminfo.ticker + " is not on the HTF ticker list", text_color = color.gray, text_size = ts)
    else
        k = 0
        while k < array.size(rows)
            f = str.split(array.get(rows, k), ",")
            // 2x2: first | last seen, then streaks (+ list row) | next ticker
            table.cell(panel, 0, r, "First seen  " + fmt(array.get(f, 1)), text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 1, r, "Last seen  " + fmt(array.get(f, 2)), text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 0, r + 1, "Streaks  " + array.get(f, 3) + "   (row " + array.get(f, 0) + ")", text_color = color.aqua, text_size = ts, text_halign = text.align_left)
            table.cell(panel, 1, r + 1, "Next  " + array.get(f, 4), text_color = color.orange, text_size = ts, text_halign = text.align_left)
            r += 2
            k += 1
