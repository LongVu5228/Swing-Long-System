//@version=6
// HTF Flag Playback — proof of concept
//
// No inputs, no prompts. Annotation data is hardcoded in the DATA block below. On load the
// script checks which ticker is on the chart, loads only that ticker's entries, and draws
// them. Add it once and leave it on; it lights up on annotated tickers and stays silent on
// everything else.
//
// In the real version the DATA block is generated by the Python ingestion script from the
// master annotation table. The three tickers below are placeholder dates for demo only.

indicator("HTF Flag Playback", overlay = true, max_boxes_count = 100, max_lines_count = 100)

var float[] bStart = array.new_float()
var float[] bEnd   = array.new_float()
var float[] bRes   = array.new_float()
var int[]   bType  = array.new_int()
var float[] bHi    = array.new_float()
var float[] bLo    = array.new_float()
var int[]   bT0    = array.new_int()
var int[]   bT1    = array.new_int()

add(float startYmd, float endYmd, float resPx, int typeCode) =>
    array.push(bStart, startYmd)
    array.push(bEnd, endYmd)
    array.push(bRes, resPx)
    array.push(bType, typeCode)
    array.push(bHi, float(na))
    array.push(bLo, float(na))
    array.push(bT0, int(na))
    array.push(bT1, int(na))

// ---------------------------------------------------------------------------------------
// DATA  (startYmd, endYmd, resistancePrice, type)   type: 1 = HL_FLAG, 2 = SHAKEOUT_RECLAIM
// resistancePrice 0 = no line
// ---------------------------------------------------------------------------------------
if barstate.isfirst
    if syminfo.ticker == "ARM"
        add(20250303, 20250321, 0, 1)
        add(20250902, 20250919, 0, 2)
    if syminfo.ticker == "SPY"
        add(20250203, 20250221, 0, 1)
        add(20250804, 20250822, 0, 1)
    if syminfo.ticker == "TSLA"
        add(20250401, 20250417, 0, 2)
        add(20251103, 20251121, 0, 1)
// ---------------------------------------------------------------------------------------

ymd(t) => float(year(t) * 10000 + month(t) * 100 + dayofmonth(t))

n = array.size(bStart)
d = ymd(time)

if n > 0
    for i = 0 to n - 1
        if d >= array.get(bStart, i) and d <= array.get(bEnd, i)
            h = array.get(bHi, i)
            l = array.get(bLo, i)
            array.set(bHi, i, na(h) ? high : math.max(h, high))
            array.set(bLo, i, na(l) ? low : math.min(l, low))
            if na(array.get(bT0, i))
                array.set(bT0, i, time)
            array.set(bT1, i, time)

if barstate.islast and n > 0
    for i = 0 to n - 1
        hi = array.get(bHi, i)
        lo = array.get(bLo, i)
        if not na(hi) and not na(lo)
            t0 = array.get(bT0, i)
            t1 = array.get(bT1, i)
            pad = (hi - lo) * 0.01
            col = array.get(bType, i) == 2 ? color.red : color.green
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 50), border_width = 1, bgcolor = color.new(col, 90))
            r = array.get(bRes, i)
            if r > 0
                wanted = t1 + (t1 - t0)
                extEnd = wanted > time ? time : wanted
                line.new(x1 = t0, y1 = r, x2 = extEnd, y2 = r, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted)
