f17_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 17", confirm = true)
f17_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 17", confirm = true)
f17_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 17")
