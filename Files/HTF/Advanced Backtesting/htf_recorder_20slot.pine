f18_pat     = input.string("Auto", "Pattern", options = ["Auto", "Green", "Red", "Perfect", "Big Green", "Big Red", "Big Perfect"], tooltip = "Auto = the recorder picks the pattern (shown on the box as \"(auto)\"). Pick one here only to override it.", group = "Flag 18")
f18_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 18", confirm = true)
f18_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 18", confirm = true)
