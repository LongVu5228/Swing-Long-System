D7 = ";TPICQ:210111-210114,220809-220818|220809-220812|220809-220825,230424-230427;TPL:210316-210520,220308-220316,260225-260312|210303-210520,220308-220310,260225-260312|210309-210520,260309-260312;TPP:081105-081111|081105-081111|081105-081111;TPR:080818-080828,110929-110930,201111-201112|080818-080822,110929-110930|080818-080828,110929-110930;TPST:|231220-231221|231220-231221;TPTX:191112-200110,200825-201019,220502-220524|191223-200113,201019-201116,220520-220523|191112-200113;TQNT:071105-071119,080429-080506,090624-090724|071105-071119,080424-080512,090624-090724|071114-071119,080424-080512,080818-080819,090624-090728;TRA:070301-070313,071002-071116,071231-080117,080425-080428,080609-080702,090123-090317|070301-070313,071002-071119,071231-080117,080423-080428,080609-080701,090218-090408|070301-070313,071002-071119,071231-080117,080423-080701,090303-090407;TRAX:260709-260810|260721-260820|;TREE:150810-150827,151105-151112,160706-160712,161129-161205,181109-181212,230210-230221,240508-240509,250324-250404|150810-150827,160706-160712,181109-181217,230213-230223,240109-240305,240508-240509,250324-250407|150810-150827,151103-151119,160706-160712,161202-161205,181109-181214,240214-240509,240823-240911;TRGP:140708-140709,160226-160519,200504-200611|140708-140709,160324-160519|140708-140709,160510-160519;TRHC:180326-180413,190812-190826|180328-180413,180913-180918,190812-190829|180327-180413,180913-180918,190812-190829;TRI:081209-081212,260805-260821|081215-090112,260805-260821|081217-090112,260805-260820;TRIL:200113-200318,200909-200924|200113-200318,200909-200918|200113-200318,200513-200706,200909-201001;TRIP:120213-120215,180215-180302,210226-210322|180215-180302,210304-210330|180215-180223,210312-210329;TRLA:130301-130325,130809-130920,140328-140813,141201-141202|130301-130325,130809-131001,140402-140813,141125-141203|130809-130924,140403-140813,141120-141203;TRLG:080516-080529,110808-110816|080710-080818,110808-110816|080516-080529,080710-080930,110808-110816;TRLV:251222-260102,260903-260921||260901-260921;TRMB:070815-070822|070815-070822|070815-070822;TRMK:080915-080925||090213-090219;TRML:||240229-240307;TRN:111027-111031|111027-111109|111027-111109;TRNS:260219-260223||;TROO:210709-210730|210709-210730|210709-210730;TROW:080808-080812,090427-090501|080808-080812,090429-090512|080808-080812,090427-090501;TROX:161122-161205,170308-170310,260204-260219,260330-260414|161122-161206,170120-170123,170308-170314,260204-260424|161122-161206,170120-170123,170308-170314,210921-210922,260326-260511"
D8 = ";TRQ:061030-061114,071015-071025,080303-080317,080717-080729,090326-090331,090707-091015,101209-101217,111102-111213,120621-120628,120924-120927,140117-140318,190227-190301|061030-061114,071015-071116,080303-080317,080717-080729,090326-090513,090707-091015,101209-101217,111102-111213,120621-120628,120924-120927,140117-140307,190227-190301|061030-061114,071015-071116,080303-080317,080717-080729,090406-090513,090707-091015,101209-101217,111102-111213,120621-120628,120924-120927,140117-140318,190227-190305;TRT:260423-260521|260423-260529|260423-260526;TRUE:140825-140917,141209-150102,151211-151218|140825-140918,141211-141231,151211-151218|141209-150109,151211-151218;TRUP:211027-211223,230801-230821,240808-240828|200810-201021,211130-211223,240802-240910|201023-201127,211028-211223,231129-231205,240809-240910,241104-241106,241213-241217;TRV:080917-080919,081113-081210|080917-080918,081113-081229|080917-080930,081113-081229,090401-090424;TRVG:170503-170721,180116-180212,210312-210316|170503-170721,180117-180212|170703-170721,180117-180212;TRVI:250310-250403|250310-250403|250310-250403,250807-250811;TRVN:150902-151001,200929-201009|150902-151001,200803-200804|150902-151001,200810-200817,200929-201009;TRW:090702-090812,091109-091130|090520-090821,091109-091130|090520-090831,091109-091130;TRX:260129-260225|260129-260312|260129-260312;TSAT:230816-230912|230816-230912|230816-230912,260812-260813;TSEM:251113-251222,260324-260421|150202-150211,251113-260212,260324-260608|150205-150211,251113-260603;TSEOQ:221125-221129||160321-160322;TSFG:080812-080926|080917-081001|;TSHA:221116-221122,230821-230921|230821-230921|230821-230921;TSL:070216-070503,070711-070726,070928-071001,071231-080103,080411-080605,090414-090610,091013-100115,101015-101020,110228-110307,120113-120222,120514-120517,130103-130220,130429-131028,151007-151014|070323-070503,070711-070723,080418-080605,090414-090728,091106-100115,101015-101020,110228-110307,120113-120228,120514-120517,130103-130220,130429-130520,130711-131119,151007-151014|070711-070726,070928-071001,080418-080423,080828-080829,090522-090813,091008-100115,101015-101020,110228-110307,120514-120517,130103-130220,130429-131119,140113-140122,151007-151014"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "||" : seg   // absent ticker still yields three empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// LEGEND
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legend text colors are deliberately NOT the actual (heavily transparent) on-chart swatch
// colors -- at high layerTransparency those are too washed out to read as text. Single-window
// entries use the pure input color; overlap entries blend the two pure colors at a fixed,
// legend-only mix so they stay bright regardless of layerTransparency.
blend(base, fg, transp) =>
    a = (100 - transp) / 100.0
    r = math.round(color.r(base) * (1 - a) + color.r(fg) * a)
    g = math.round(color.g(base) * (1 - a) + color.g(fg) * a)
    b = math.round(color.b(base) * (1 - a) + color.b(fg) * a)
    color.rgb(r, g, b)

legendMix = 50
lc1m3m = blend(color1m, color3m, legendMix)
lc1m6m = blend(color1m, color6m, legendMix)
lc3m6m = blend(color3m, color6m, legendMix)
lcAll  = blend(lc1m3m, color6m, legendMix)

var table legend = table.new(
     position.bottom_left,
     4,
     3,
     bgcolor = color.new(color.white, 100),
     border_width = 0
 )

if barstate.islast
    table.cell(legend, 0, 0, "1M only", text_color = color1m, text_size = size.normal)
    table.cell(legend, 1, 0, "3M only", text_color = color3m, text_size = size.normal)
    table.cell(legend, 2, 0, "6M only", text_color = color6m, text_size = size.normal)
    table.cell(legend, 3, 0, "1M+3M+6M", text_color = lcAll, text_size = size.normal)
    table.cell(legend, 0, 1, "1M+3M", text_color = lc1m3m, text_size = size.normal)
    table.cell(legend, 1, 1, "1M+6M", text_color = lc1m6m, text_size = size.normal)
    table.cell(legend, 2, 1, "3M+6M", text_color = lc3m6m, text_size = size.normal)
    table.cell(legend, 0, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 1, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 2, 2, " ", text_color = color.new(color.white, 100))
    table.merge_cells(legend, 3, 0, 3, 1)
