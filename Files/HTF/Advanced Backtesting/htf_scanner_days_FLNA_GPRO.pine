D8 = ";GNW:081229-090106,090403-091005,100205-100212,100802-100805,111028-111116,160314-160316,160503-160523,160908-160920,180601-180608,200902-200914|090508-091005,100205-100212,100802-100805,111028-111116,160506-160523,160908-160920|090514-091005,100205-100212,100802-100805,160908-160920;GO:190821-190905,200326-200408,250414-250423|200326-200413,250414-250422|200326-200408,250414-250422;GOEVQ:220725-220803,240425-240426|240424-240426|240425-240426;GOGL:220422-220531|220421-220531|220421-220531;GOGO:130919-131218,140609-140617,181023-181114,190917-191003,200901-200929,211004-211008,220414-220425,250404-250410|131112-131218,140609-140617,181023-181119,190917-191003,200828-201026,211004-211008,220412-220428,250408-250410|140312-140314,140609-140617,181023-181116,190917-191003,200902-201026,211004-211008,250403-250410;GOLD:080122-080204,081202-081219,240418-240425,260209-260224|080122-080319,081208-090303,240424-240513,260204-260302|080122-080319,081210-090406,240423-240425,260206-260302;GOMO:140214-140313|140305-140312|;GOOS:180212-180213,180622-180709,181008-181009,181116-181206,190214-190222|180208-180213,180622-180709,181008-181009,181116-181210,190214-190222|180208-180213,180622-180709,181008-181009,181116-181210,190214-190222;GOSS:191122-191125,220714-220729|191122-191129,220725-220916|191127-191203,220801-220916;GOTU:190812-191212,200123-200401,200616-200819,201001-201022,210126-210223,211013-211021,220627-220705,221219-230118,230308-230316,231214-231215,240214-240308,250311-250326|191002-191212,200123-200401,200630-200819,201001-201022,210127-210304,221219-230322,231213-231215,240226-240322,250311-250327|191204-191212,200123-200401,200514-200819,201001-201022,220627-220701,221222-230410,240222-240322,240521-240528,250311-250324;GOVX:220808-220818|220808-220818|;GP:201120-201127||201120-210120;GPCR:230921-231110,240207-240215,240606-240625,250502-250512,251117-260126|230921-231110,240207-240215,240607-240625,251105-260206|230921-231110,240207-240222,240620-240625,251208-260206;GPI:090713-090724,201022-201027|090430-090508,090716-090720|090430-090511,090702-090724,111101-111107,201022-201023;GPOR:230313-230322|220509-220513|220510-220513;GPORQ:110321-110414,110802-110805,111026-111114,120717-120813,141117-141128,160126-160219,191107-191111|110307-110414,110802-110805,111026-111116,120718-120813,141117-141128,160126-160218|110307-110414,110802-110805,111026-111123,120717-120813,141117-141128,160126-160218;GPRE:140328-140410,150209-150210,181018-181025,190920-190927,220518-220601,260209-260220|140328-140410,150316-150323,151207-160106,181018-181025,220518-220524,260325-260406|140327-140410,151012-151016,151210-160106,181018-181025,210804-210813,220518-220520,260330-260406;GPRO:140912-141016,160628-161012,170816-170927,191001-191007,201013-201026,210318-210401,250730-250924|140925-141016,160630-161012,170816-171002,191001-191007,250808-251006|160715-161012,170816-171004,181009-181025,191001-191007,250912-250922"

color1m = input.color(color.aqua, "1M Color")
color3m = input.color(color.fuchsia, "3M Color")
color6m = input.color(color.yellow, "6M Color")
layerTransparency = input.int(80, "Layer Transparency", minval = 0, maxval = 100, tooltip = "Applied per window layer; overlapping windows blend since each layer is drawn on top of the last")

// Returns this ticker's "1m|3m|6m" body from one piece, or "" if not in it.
cut(string src, string k) =>
    p = str.pos(src, k)
    rest = na(p) ? "" : str.substring(src, p + str.length(k))
    q = str.pos(rest, ";")
    na(q) ? rest : str.substring(rest, 0, q)

key = ";" + syminfo.ticker + ":"
s0 = cut(D0, key)
s1 = cut(D1, key)
s2 = cut(D2, key)
s3 = cut(D3, key)
s4 = cut(D4, key)
s5 = cut(D5, key)
s6 = cut(D6, key)
s7 = cut(D7, key)
s8 = cut(D8, key)
seg = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
segp = seg == "" ? "||" : seg   // absent ticker still yields three empty fields

// Appending "-" guarantees split yields >= 2 elements; an empty field pushes one na pair
// that never matches. Keeps this free of `if`.
fill(string s, int[] rs, int[] re) =>
    parts = str.split(s, ",")
    j = 0
    while j < array.size(parts)
        r = str.split(array.get(parts, j) + "-", "-")
        array.push(rs, int(str.tonumber(array.get(r, 0))))
        array.push(re, int(str.tonumber(array.get(r, 1))))
        j += 1

var int[] rs1 = array.new<int>()
var int[] re1 = array.new<int>()
var int[] rs3 = array.new<int>()
var int[] re3 = array.new<int>()
var int[] rs6 = array.new<int>()
var int[] re6 = array.new<int>()
var bool parsed = false
while not parsed
    parsed := true
    ws = str.split(segp, "|")
    fill(array.get(ws, 0), rs1, re1)
    fill(array.get(ws, 1), rs3, re3)
    fill(array.get(ws, 2), rs6, re6)

hit(int[] rs, int[] re, int d) =>
    h = false
    i = 0
    while i < array.size(rs)
        h := h or (d >= array.get(rs, i) and d <= array.get(re, i))
        i += 1
    h

d = (year % 100) * 10000 + month * 100 + dayofmonth
hit1m = hit(rs1, re1, d)
hit3m = hit(rs3, re3, d)
hit6m = hit(rs6, re6, d)

bgcolor(hit1m ? color.new(color1m, layerTransparency) : na)
bgcolor(hit3m ? color.new(color3m, layerTransparency) : na)
bgcolor(hit6m ? color.new(color6m, layerTransparency) : na)

// Pine has no way to react to mouse/crosshair position or render text that only appears on
// hover -- scripts only ever see the bar data, never UI state. This is the closest real
// equivalent: hidden from the chart/scale (display.data_window only), so hovering any bar
// shows these three 0/1 flags in TradingView's own Data Window panel.
plot(hit1m ? 1 : 0, title = "1M hit", display = display.data_window)
plot(hit3m ? 1 : 0, title = "3M hit", display = display.data_window)
plot(hit6m ? 1 : 0, title = "6M hit", display = display.data_window)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// LEGEND
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legend text colors are deliberately NOT the actual (heavily transparent) on-chart swatch
// colors -- at high layerTransparency those are too washed out to read as text. Single-window
// entries use the pure input color; overlap entries blend the two pure colors at a fixed,
// legend-only mix so they stay bright regardless of layerTransparency.
blend(base, fg, transp) =>
    a = (100 - transp) / 100.0
    r = math.round(color.r(base) * (1 - a) + color.r(fg) * a)
    g = math.round(color.g(base) * (1 - a) + color.g(fg) * a)
    b = math.round(color.b(base) * (1 - a) + color.b(fg) * a)
    color.rgb(r, g, b)

legendMix = 50
lc1m3m = blend(color1m, color3m, legendMix)
lc1m6m = blend(color1m, color6m, legendMix)
lc3m6m = blend(color3m, color6m, legendMix)
lcAll  = blend(lc1m3m, color6m, legendMix)

var table legend = table.new(
     position.bottom_left,
     4,
     3,
     bgcolor = color.new(color.white, 100),
     border_width = 0
 )

if barstate.islast
    table.cell(legend, 0, 0, "1M only", text_color = color1m, text_size = size.normal)
    table.cell(legend, 1, 0, "3M only", text_color = color3m, text_size = size.normal)
    table.cell(legend, 2, 0, "6M only", text_color = color6m, text_size = size.normal)
    table.cell(legend, 3, 0, "1M+3M+6M", text_color = lcAll, text_size = size.normal)
    table.cell(legend, 0, 1, "1M+3M", text_color = lc1m3m, text_size = size.normal)
    table.cell(legend, 1, 1, "1M+6M", text_color = lc1m6m, text_size = size.normal)
    table.cell(legend, 2, 1, "3M+6M", text_color = lc3m6m, text_size = size.normal)
    table.cell(legend, 0, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 1, 2, " ", text_color = color.new(color.white, 100))
    table.cell(legend, 2, 2, " ", text_color = color.new(color.white, 100))
    table.merge_cells(legend, 3, 0, 3, 1)
