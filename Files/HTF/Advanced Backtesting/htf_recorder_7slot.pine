//@version=6
// HTF Manual Flag Recorder — 7 slots. GENERATED by generate_recorder.py; edit that, not this.
//
// Records discretionary flag annotations inside TradingView and publishes them as a
// KEY/VALUE stream on the final bars so Chart Data Export carries them to CSV. Two plots
// regardless of slot count (Pine caps a script at 64). Dates are YYYYMMDD. See README.md.
//
// Every slot's default start/confirmed/end are the SAME date, which the script treats as
// unused -- so if the placement popup's x button finishes the add with defaults, hitting
// it after your last real flag leaves the remaining slots empty. If it instead cancels
// the whole add, spam-click one candle through the leftover prompts; same result.

indicator("HTF Manual Flag Recorder (7)", overlay = true, max_boxes_count = 50, max_lines_count = 150, max_labels_count = 50)

// Schema 3 drops the review-status field (key 2) that schema 2 carried. Reviewed-ness
// is now implied by the export existing at all: a downloaded chart means flags were
// found, and a ticker never exported means none were.
SCHEMA_VERSION = 3
N_SLOTS = 7

G_DISP   = "Display"

showTable    = input.bool(true, "Show summary table", group = G_DISP)
boxPad       = input.float(1.0, "Box padding %", minval = 0.0, maxval = 10.0, group = G_DISP)
// Spanning fewer than this many calendar days means the slot was skipped, not drawn.
// Spam-clicking one candle to burn leftover prompts gives a 0-day span, but the mouse
// drifts -- a few days of slop still reads as "skipped" so a stray click cannot create a
// junk flag. Real flags run weeks, so this cannot swallow a genuine one.
minSpan      = input.int(5, "Min flag span (days)", minval = 0, group = G_DISP)

// Same four clicks serve both setup types; the dropdown (set afterward) decides how
// they're read. HL_FLAG: start / higher-low confirmed / final end / R1. LOWER_LOW: start /
// lower-low confirmed / reclaim end / R1 (reclaim only). For LOWER_LOW, click 3 on the
// same bar as click 2 = no reclaim; the script derives LL_NO_RECLAIM vs LL_RECLAIM itself.
f1_on      = input.bool(true, "Enabled", group = "Flag 1")
f1_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 1")
f1_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 1", confirm = true)
f1_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 1", confirm = true)
f1_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 1", confirm = true)
f1_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 1", confirm = true)
f1_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 1")
f1_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 1")
f1_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 1")
f1_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 1")

f2_on      = input.bool(true, "Enabled", group = "Flag 2")
f2_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 2")
f2_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 2", confirm = true)
f2_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 2", confirm = true)
f2_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 2", confirm = true)
f2_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 2", confirm = true)
f2_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 2")
f2_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 2")
f2_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 2")
f2_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 2")

f3_on      = input.bool(true, "Enabled", group = "Flag 3")
f3_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 3")
f3_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 3", confirm = true)
f3_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 3", confirm = true)
f3_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 3", confirm = true)
f3_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 3", confirm = true)
f3_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 3")
f3_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 3")
f3_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 3")
f3_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 3")

f4_on      = input.bool(true, "Enabled", group = "Flag 4")
f4_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 4")
f4_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 4", confirm = true)
f4_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 4", confirm = true)
f4_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 4", confirm = true)
f4_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 4", confirm = true)
f4_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 4")
f4_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 4")
f4_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 4")
f4_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 4")

f5_on      = input.bool(true, "Enabled", group = "Flag 5")
f5_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 5")
f5_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 5", confirm = true)
f5_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 5", confirm = true)
f5_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 5", confirm = true)
f5_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 5", confirm = true)
f5_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 5")
f5_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 5")
f5_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 5")
f5_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 5")

f6_on      = input.bool(true, "Enabled", group = "Flag 6")
f6_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 6")
f6_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 6", confirm = true)
f6_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 6", confirm = true)
f6_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 6", confirm = true)
f6_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 6", confirm = true)
f6_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 6")
f6_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 6")
f6_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 6")
f6_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 6")

f7_on      = input.bool(true, "Enabled", group = "Flag 7")
f7_type    = input.string("HL_FLAG", "Setup type", options = ["HL_FLAG", "LOWER_LOW"], group = "Flag 7")
f7_start   = input.time(timestamp("2000-01-03"), "1. Start", group = "Flag 7", confirm = true)
f7_conf    = input.time(timestamp("2000-01-03"), "2. Confirmed (HL or LL)", group = "Flag 7", confirm = true)
f7_end     = input.time(timestamp("2000-01-03"), "3. End / reclaim end", group = "Flag 7", confirm = true)
f7_r1_bar  = input.time(timestamp("1900-01-02"), "4. R1 candle (its high = level)", tooltip = "Click the candle whose HIGH is the level. The high is read from that bar -- no need to place the price by eye.", group = "Flag 7", confirm = true)
f7_r1_same = input.bool(true, "R1 effective = auto", tooltip = "The confirmed date (click 2) -- when the level goes live and you start watching for the break.", group = "Flag 7")
f7_r1_alt  = input.time(timestamp("2000-01-03"), "R1 effective (override)", group = "Flag 7")
f7_r2_bar  = input.time(timestamp("1900-01-02"), "R2 candle (its high = level)", group = "Flag 7")
f7_r2_date = input.time(timestamp("2000-01-03"), "R2 effective", group = "Flag 7")

tlabel(code) => code == 1 ? "HL" : code == 2 ? "LL fail" : "LL reclaim"
ymd(t) => na(t) ? float(na) : float(year(t) * 10000 + month(t) * 100 + dayofmonth(t))
md(t) => str.tostring(month(t)) + "/" + str.tostring(dayofmonth(t))
mdy(t) => md(t) + "/" + str.tostring(year(t) % 100)
NO_BAR = ymd(timestamp("1900-01-02"))  // sentinel: resistance candle not set

var bool[]   sOn     = array.new<bool>()
var string[] sType   = array.new<string>()
var int[]    sStart  = array.new<int>()
var int[]    sConf   = array.new<int>()
var int[]    sEnd    = array.new<int>()
var int[]    sR1bar  = array.new<int>()
var bool[]   sR1same = array.new<bool>()
var int[]    sR1alt  = array.new<int>()
var int[]    sR2bar  = array.new<int>()
var int[]    sR2date = array.new<int>()

addSlot(bool on, string typ, int tStart, int tConf, int tEnd, int r1bar, bool r1same, int r1alt, int r2bar, int r2date) =>
    array.push(sOn, on)
    array.push(sType, typ)
    array.push(sStart, tStart)
    array.push(sConf, tConf)
    array.push(sEnd, tEnd)
    array.push(sR1bar, r1bar)
    array.push(sR1same, r1same)
    array.push(sR1alt, r1alt)
    array.push(sR2bar, r2bar)
    array.push(sR2date, r2date)

if barstate.isfirst
    addSlot(f1_on, f1_type, f1_start, f1_conf, f1_end, f1_r1_bar, f1_r1_same, f1_r1_alt, f1_r2_bar, f1_r2_date)
    addSlot(f2_on, f2_type, f2_start, f2_conf, f2_end, f2_r1_bar, f2_r1_same, f2_r1_alt, f2_r2_bar, f2_r2_date)
    addSlot(f3_on, f3_type, f3_start, f3_conf, f3_end, f3_r1_bar, f3_r1_same, f3_r1_alt, f3_r2_bar, f3_r2_date)
    addSlot(f4_on, f4_type, f4_start, f4_conf, f4_end, f4_r1_bar, f4_r1_same, f4_r1_alt, f4_r2_bar, f4_r2_date)
    addSlot(f5_on, f5_type, f5_start, f5_conf, f5_end, f5_r1_bar, f5_r1_same, f5_r1_alt, f5_r2_bar, f5_r2_date)
    addSlot(f6_on, f6_type, f6_start, f6_conf, f6_end, f6_r1_bar, f6_r1_same, f6_r1_alt, f6_r2_bar, f6_r2_date)
    addSlot(f7_on, f7_type, f7_start, f7_conf, f7_end, f7_r1_bar, f7_r1_same, f7_r1_alt, f7_r2_bar, f7_r2_date)

// Derived per slot, computed once. Type codes: 1 HL_FLAG, 2 LL_NO_RECLAIM, 3 LL_RECLAIM.
// Start/end are sorted so clicking end-before-start still yields a box. A slot whose
// start and end land on the same bar is unused -- the spam-click / default-value skip.
var int[]   dT0     = array.new<int>()
var int[]   dT1     = array.new<int>()
var bool[]  dUsed   = array.new<bool>()
var int[]   dCode   = array.new<int>()
var int[]   dR1date = array.new<int>()
var bool[]  dReclm  = array.new<bool>()
var float[] aHi     = array.new<float>()
var float[] aLo     = array.new<float>()
var float[] aR1px   = array.new<float>()
var float[] aR2px   = array.new<float>()

if barstate.isfirst
    for i = 0 to N_SLOTS - 1
        st = array.get(sStart, i)
        cf = array.get(sConf, i)
        en = array.get(sEnd, i)
        t0 = st < en ? st : en
        t1 = st < en ? en : st
        used = array.get(sOn, i) and (t1 - t0) >= minSpan * 86400000
        isLL = array.get(sType, i) == "LOWER_LOW"
        reclaim = isLL and ymd(en) != ymd(cf)
        code = isLL ? (reclaim ? 3 : 2) : 1
        // Always the confirmed date, both types. Anchoring LOWER_LOW to the reclaim-end
        // instead made the level go live on the very bar it broke -- a level with no watch
        // window in front of it is untestable. From the confirmed date there's a real
        // window: line is live, price sits below it, the break is the entry.
        r1date = array.get(sR1same, i) ? cf : array.get(sR1alt, i)
        array.push(dT0, t0)
        array.push(dT1, t1)
        array.push(dUsed, used)
        array.push(dCode, code)
        array.push(dR1date, r1date)
        array.push(dReclm, reclaim)
        array.push(aHi, float(na))
        array.push(aLo, float(na))
        array.push(aR1px, float(na))
        array.push(aR2px, float(na))

// Box height comes from the bars inside each slot's date range, and each resistance level
// is the HIGH of the single bar that was clicked for it. Compared as YYYYMMDD so the
// clicked bar is always included regardless of the intraday moment the click landed. A
// resistance bar that matches nothing (unset, default date) leaves its price na -> no line.
d = ymd(time)
for i = 0 to N_SLOTS - 1
    if array.get(dUsed, i) and d >= ymd(array.get(dT0, i)) and d <= ymd(array.get(dT1, i))
        h = array.get(aHi, i)
        l = array.get(aLo, i)
        array.set(aHi, i, na(h) ? high : math.max(h, high))
        array.set(aLo, i, na(l) ? low : math.min(l, low))
    if d == ymd(array.get(sR1bar, i))
        array.set(aR1px, i, high)
    if d == ymd(array.get(sR2bar, i))
        array.set(aR2px, i, high)

if barstate.islast
    for i = 0 to N_SLOTS - 1
        hi = array.get(aHi, i)
        lo = array.get(aLo, i)
        if array.get(dUsed, i) and not na(hi) and not na(lo)
            t0 = array.get(dT0, i)
            t1 = array.get(dT1, i)
            tc = array.get(sConf, i)
            pad = (hi - lo) * boxPad / 100.0
            col = array.get(dCode, i) == 1 ? color.green : color.red
            box.new(left = t0, top = hi + pad, right = t1, bottom = lo - pad, xloc = xloc.bar_time, border_color = color.new(col, 50), border_width = 1, bgcolor = color.new(col, 90), force_overlay = true)
            line.new(x1 = tc, y1 = lo - pad, x2 = tc, y2 = hi + pad, xloc = xloc.bar_time, color = color.new(col, 50), width = 1, style = line.style_dashed, force_overlay = true)
            // Slot number at the box's top edge, so a box on the chart maps back to its
            // "Flag N" settings group -- otherwise there's no way to tell which group to
            // edit when revisiting a chart with many flags. Midpoint is in time, not bar
            // count, so weekend gaps shift it slightly off visual center; close enough.
            label.new(x = int((t0 + t1) / 2), y = hi + pad, text = str.tostring(i + 1), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = color.new(col, 30), textcolor = color.white, size = size.small, force_overlay = true)
            wanted = t1 + (t1 - t0)
            extEnd = wanted > time ? time : wanted
            isLL = array.get(dCode, i) != 1
            rOK = not isLL or array.get(dReclm, i)
            r1px = array.get(aR1px, i)
            r2px = array.get(aR2px, i)
            // Drawn from the source candle so you can see which high it came from; the
            // effective date (when it becomes tradeable) is carried in the export.
            if rOK and not na(r1px)
                line.new(x1 = array.get(sR1bar, i), y1 = r1px, x2 = extEnd, y2 = r1px, xloc = xloc.bar_time, color = color.orange, width = 2, style = line.style_dotted, force_overlay = true)
            if rOK and not na(r2px)
                line.new(x1 = array.get(sR2bar, i), y1 = r2px, x2 = extEnd, y2 = r2px, xloc = xloc.bar_time, color = color.blue, width = 2, style = line.style_dotted, force_overlay = true)

// Export record. Key = slot*100 + field; see README for the field map.
var int[]   kk = array.new_int()
var float[] vv = array.new_float()

push(int k, float v) =>
    array.push(kk, k)
    array.push(vv, v)

// Resistance is exported as the SOURCE BAR DATE, not a price: the price is that bar's
// high, which the parser reads from the OHLC columns of this very CSV. Deriving it here
// would be wrong anyway -- the record is emitted across the final bars, so a source bar
// inside that window wouldn't have been scanned yet when its slot is written.
if barstate.isfirst
    push(1, float(SCHEMA_VERSION))
    for i = 0 to N_SLOTS - 1
        b = (i + 1) * 100
        u = array.get(dUsed, i)
        rOK = u and (array.get(dCode, i) == 1 or array.get(dReclm, i))
        r1bar = ymd(array.get(sR1bar, i))
        r2bar = ymd(array.get(sR2bar, i))
        r1 = rOK and r1bar != NO_BAR
        r2 = rOK and r2bar != NO_BAR
        push(b + 1, u ? 1.0 : 0.0)
        push(b + 2, u ? float(array.get(dCode, i)) : float(na))
        push(b + 3, u ? ymd(array.get(dT0, i)) : float(na))
        push(b + 4, u ? ymd(array.get(sConf, i)) : float(na))
        push(b + 5, u ? ymd(array.get(dT1, i)) : float(na))
        push(b + 6, r1 ? ymd(array.get(dR1date, i)) : float(na))
        push(b + 7, r1 ? r1bar : float(na))
        push(b + 8, r2 ? ymd(array.get(sR2date, i)) : float(na))
        push(b + 9, r2 ? r2bar : float(na))

// Record lands on the final bars so the parser finds it at a predictable end of the CSV.
offset = last_bar_index - bar_index
inRange = offset >= 0 and offset < array.size(kk)
annoKey = inRange ? array.get(kk, offset) : int(na)
annoVal = inRange ? array.get(vv, offset) : float(na)

plot(annoKey, "ANNO_KEY", display = display.data_window)
plot(annoVal, "ANNO_VAL", display = display.data_window)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 2, border_width = 1)
    flagsTxt = ""
    nSkipped = 0
    for i = 0 to N_SLOTS - 1
        t0 = array.get(dT0, i)
        t1 = array.get(dT1, i)
        // A skipped slot that spans more than a day was probably mouse drift, not a
        // deliberate skip -- surfaced so it can't silently swallow a real flag.
        if not array.get(dUsed, i) and (t1 - t0) > 86400000
            nSkipped += 1
        if array.get(dUsed, i)
            row = str.tostring(i + 1) + ": " + tlabel(array.get(dCode, i)) + "  " + mdy(t0) + "-" + mdy(t1) + "  (conf " + mdy(array.get(sConf, i)) + ")"
            flagsTxt := flagsTxt == "" ? row : flagsTxt + "\n" + row
    table.cell(t, 0, 0, "flags", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, flagsTxt == "" ? "-" : flagsTxt, text_color = color.black, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 0, 1, "skipped", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, nSkipped == 0 ? "-" : str.tostring(nSkipped) + " (stray clicks, under min span)", text_color = nSkipped == 0 ? color.gray : color.red, text_size = size.small)
